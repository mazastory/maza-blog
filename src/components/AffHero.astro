---
// 제휴 홈의 제목 영역 — 제목·한 줄 설명·특징 칩·광고 고지(고지 문구는 설정 값 그대로, 눈에 띄게)
interface Props { title: string; intro: string; disclosure: string; dark: boolean; chips?: string[]; }
const { title, intro, disclosure, dark, chips = [] } = Astro.props;
---
<header class="relative">
  <h1 class={`text-3xl md:text-5xl font-black tracking-tight leading-tight ${dark ? 'bg-gradient-to-r from-white via-teal-200 to-sky-300 bg-clip-text text-transparent' : 'text-slate-900'}`}>{title}</h1>
  <p class={`mt-4 max-w-3xl text-base md:text-lg leading-relaxed ${dark ? 'text-slate-300' : 'text-slate-600'}`}>{intro}</p>
  {chips.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-2 no-print">
      {chips.map((c) => (<li class={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-semibold ${dark ? 'border-teal-400/25 bg-teal-400/10 text-teal-200' : 'border-teal-600/20 bg-teal-50 text-teal-800'}`}><span aria-hidden="true">✓</span>{c}</li>))}
    </ul>
  )}
  <p class={`mt-4 inline-block rounded-lg border px-3 py-2 text-sm font-bold leading-snug ${dark ? 'border-amber-400/30 bg-amber-400/10 text-amber-300' : 'border-amber-300 bg-amber-50 text-amber-800'}`} role="note">{disclosure}</p>
</header>
