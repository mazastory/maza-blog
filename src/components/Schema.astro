---
export interface Props {
  type: 'WebSite' | 'Article';
  title: string;
  description: string;
  url: string;
  image?: string;
  authorName?: string;
  publisherName?: string;
  datePublished?: string;
}

const { type, title, description: rawDescription, url, image, authorName, publisherName, datePublished } = Astro.props;
const description = rawDescription ? rawDescription.replace(/<[^>]*>?/gm, '').replace(/\s+/g, ' ').trim() : '';

const schema: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": type,
  "name": title,
  "headline": title,
  "description": description,
  "url": url,
};

if (type === 'Article') {
  if (image) schema.image = [image];
  if (authorName) {
    schema.author = {
      "@type": "Person",
      "name": authorName
    };
    schema.publisher = {
      "@type": "Organization",
      "name": publisherName || authorName,
      "logo": {
        "@type": "ImageObject",
        // [2026-08-28 수리] Astro.site 를 먼저 쓰면 실제 요청 도메인 대신 항상
        // 'https://example.com' 이 찍혔다 — 12개 사이트 전부가 하나의 Vercel
        // 배포를 여러 커스텀 도메인으로 공유하는데, 그 빌드 시점에
        // PUBLIC_SITE_DOMAIN/SITE_DOMAIN/Vercel URL 이 전부 안 잡혀 있어
        // astro.config.mjs 의 마지막 폴백('https://example.com')이 항상 이겼다.
        // output:'server'(SSR)라 Astro.url 은 요청마다 실제 도메인을 담고
        // 있으므로, 정적 빌드값(Astro.site)보다 이걸 우선한다.
        "url": new URL('/favicon.svg', Astro.url.origin || Astro.site).toString()
      }
    };
  }
  if (datePublished) schema.datePublished = datePublished;
}
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
