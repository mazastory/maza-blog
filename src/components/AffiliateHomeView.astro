---
import Layout from '../layouts/Layout.astro';
import PlannerTool from './tools/PlannerTool.astro';
import FreePack from './FreePack.astro';
import BreakEvenTool from './tools/BreakEvenTool.astro';
import type { AffiliateHomeConfig } from '../lib/affiliateHome';
interface Props { cfg: AffiliateHomeConfig; siteConfig: any; only?: string; }
const { cfg, siteConfig, only } = Astro.props;
const safeHref = (u: string) => (/^https:\/\/(naver\.me|brandconnect\.naver\.com)\//.test(u) ? u : '#');
const safeEmbed = (u: string) => (/^https:\/\/(www\.)?setupod\.com\/embed\/[a-z0-9_-]+(\?[^\s"]*)?$/i.test(u) ? u : '');
const safeImg = (u?: string) => (u && /^https:\/\/[A-Za-z0-9.-]+\/[^\s"'<>]*$/.test(u) ? u : '');
const dark = siteConfig?.metadata?.page_theme === 'dark';
const BUILTIN = ['planner', 'breakeven'];
const rawTools: any[] = cfg.tool?.tools?.length ? cfg.tool.tools : cfg.tool ? [cfg.tool] : [];
const validTools = rawTools.filter((t) => (t.builtin && BUILTIN.includes(t.builtin)) || (t.embed_url && safeEmbed(t.embed_url)));
// 도구가 여럿이고 특정 도구를 고르지 않았으면 홈은 「도구 고르기」 화면이다
const hub = !only && validTools.length > 1;
const toolList = only ? validTools.filter((t) => t.builtin === only) : hub ? [] : validTools;
const tool = toolList.length || hub ? cfg.tool : null;
// 쿠팡 배너: 값만 받아서 우리가 스크립트를 만든다(숫자·정해진 글자만 통과)
const cpOk = (b: any) => {
  if (!/^(\d{2,4}|100%)$/.test(String(b?.width)) || !/^\d{2,4}$/.test(String(b?.height))) return false;
  if (b?.kind === 'iframe') return /^https:\/\/coupa\.ng\/[A-Za-z0-9]{3,20}$/.test(String(b?.src));
  return /^\d{1,12}$/.test(String(b?.id)) && /^[A-Za-z0-9_-]{1,40}$/.test(String(b?.tracking_code)) && /^[a-z]{3,20}$/.test(String(b?.template || 'carousel'));
};
const cpHtml = (b: any) => b.kind === 'iframe'
  ? `<iframe src="${b.src}" width="${/%$/.test(String(b.width)) ? '100%' : Number(b.width)}" height="${Number(b.height)}" frameborder="0" scrolling="no" referrerpolicy="unsafe-url" title="쿠팡 파트너스 광고" loading="lazy"></iframe>`
  : '<script src="https://ads-partners.coupang.com/g.js"><\/script><script>new PartnersCoupang.G(' + JSON.stringify({ id: Number(b.id), template: b.template || 'carousel', trackingCode: String(b.tracking_code), width: String(b.width), height: String(b.height), tsource: '' }) + ')<\/script>';
const cpBySlot = (slot: string) => (cfg.coupang || []).filter((b: any) => cpOk(b) && (b.slot || 'left') === slot);
const cpLeft = tool ? cpBySlot('left') : [];
const cpRight = tool ? cpBySlot('right') : [];
const cpBottom = tool ? cpBySlot('bottom') : [];
// 사이트가 어두우면 카드·글자도 어둡게 — 도구가 「남의 것」처럼 보이지 않게 한다
const C = dark
  ? { h1: 'text-white', p: 'text-slate-300', note: 'text-slate-400', box: 'border-slate-700/70 bg-slate-900/60', boxHover: 'hover:border-slate-500', tag: 'text-slate-500', name: 'text-slate-100', sub: 'text-slate-400', strong: 'text-white', warn: 'border-amber-500/30 bg-amber-500/10 text-amber-200' }
  : { h1: 'text-slate-900', p: 'text-slate-600', note: 'text-slate-500', box: 'border-slate-200 bg-white', boxHover: 'hover:border-slate-400', tag: 'text-slate-400', name: 'text-slate-900', sub: 'text-slate-500', strong: 'text-slate-900', warn: 'border-amber-200 bg-amber-50 text-amber-900' };
const topCount = tool ? Math.max(0, Math.min(cfg.products.length, tool.top_count ?? 2)) : 0;
const slotOf = (p: any, i: number) => (p.slot as string) || (i < topCount ? 'top' : 'bottom');
const bySlot = (slot: string) => (tool ? cfg.products.filter((p, i) => slotOf(p, i) === slot) : []);
const topBanners = bySlot('top');
const leftBanners = bySlot('left');
const rightBanners = bySlot('right');
const bottomBanners = bySlot('bottom');
// 폭이 좁으면 옆 배너는 아래로 내려온다(옆 자리는 xl 이상에서만 보인다)
const sideFallback = [...leftBanners, ...rightBanners];
const narrowTop = sideFallback.slice(0, 2);
const narrowBottom = sideFallback.slice(2);
// 옆 칸이 화면보다 길면 따라다니지 않게 한다(광고가 헤더 밑으로 가려지는 것을 막는다) — 쿠팡 위젯 약 270px, 네이버 카드 약 210px
const stickyL = cpLeft.length * 270 + leftBanners.length * 210 <= 640;
const stickyR = cpRight.length * 270 + rightBanners.length * 210 <= 640;
const hasSides = leftBanners.length + rightBanners.length + cpLeft.length + cpRight.length > 0;
---

<Layout title={cfg.title} description={cfg.intro} siteConfig={siteConfig}>
  <div class={`mx-auto px-4 py-6 md:px-6 md:py-10 ${hasSides ? "max-w-[1480px]" : "max-w-4xl"}`}>
    <div class={tool && hasSides ? 'xl:hidden' : ''}>
      <h1 class={`text-3xl md:text-4xl font-black tracking-tight ${C.h1}`}>{cfg.title}</h1>
      <p class={`mt-4 leading-relaxed ${C.p}`}>{cfg.intro}</p>

      <p class={`mt-3 text-sm font-bold ${dark ? 'text-amber-300' : 'text-amber-700'}`} role="note">{cfg.disclosure}</p>
    </div>

    {tool ? (
      <>
        {topBanners.length > 0 && (
          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            {topBanners.map((p) => (
              <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" data-aff="naver" data-aff-name={p.name} class={`block rounded-xl border p-4 shadow-sm no-print ${C.box} ${C.boxHover}`}>
                <div class={`text-[11px] font-bold ${C.tag}`}>광고 · {p.store}</div>
                <div class={`mt-1 text-sm font-bold leading-snug ${C.name}`}>{p.name}</div>
                <div class={`mt-2 flex items-center justify-between text-xs ${C.sub}`}>
                  <span>확인 시점 가격 <strong class={C.strong}>{p.price}</strong></span>
                  <span class={`font-bold ${C.strong}`}>판매 페이지 →</span>
                </div>
              </a>
            ))}
          </div>
        )}

        {narrowTop.length > 0 && (
          <div class="mt-8 grid gap-3 sm:grid-cols-2 xl:hidden">
            {narrowTop.map((p) => (
              <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" data-aff="naver" data-aff-name={p.name} class={`block rounded-xl border p-4 shadow-sm no-print ${C.box} ${C.boxHover}`}>
                <div class={`text-[11px] font-bold ${C.tag}`}>광고 · {p.store}</div>
                <div class={`mt-1 text-sm font-bold leading-snug ${C.name}`}>{p.name}</div>
                <div class={`mt-2 flex items-center justify-between text-xs ${C.sub}`}>
                  <span>확인 시점 가격 <strong class={C.strong}>{p.price}</strong></span>
                  <span class={`font-bold ${C.strong}`}>판매 페이지 →</span>
                </div>
              </a>
            ))}
          </div>
        )}

        <div class={`mt-5 ${hasSides ? "xl:grid xl:grid-cols-[170px_minmax(0,1fr)_170px] xl:gap-6" : ""}`}>
          {hasSides && (
            <div class="hidden xl:block">
              <div class={`${stickyL ? 'sticky top-40 ' : ''}space-y-3`}>
                {cpLeft.map((b: any) => (<div class="no-print overflow-hidden rounded-xl"><div class={`mb-1 text-[10px] font-bold ${C.tag}`}>광고 · 쿠팡 파트너스</div><Fragment set:html={cpHtml(b)} /></div>))}
                {leftBanners.map((p) => (
                  <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" data-aff="naver" data-aff-name={p.name} class={`group block overflow-hidden rounded-xl border shadow-sm no-print ${C.box} ${C.boxHover}`}>
                    {safeImg(p.image) && (
                      <img src={safeImg(p.image)} alt={p.name} loading="lazy" decoding="async" referrerpolicy="no-referrer" class="h-[100px] w-full object-cover" />
                    )}
                    <div class="p-3">
                      <div class={`text-[10px] font-bold ${C.tag}`}>광고 · {p.store}</div>
                      <div class={`mt-1 text-xs font-bold leading-snug line-clamp-2 ${C.name}`}>{p.name}</div>
                      <div class="mt-2 flex items-end justify-between gap-1">
                        <span class={`text-sm font-black ${C.strong}`}>{p.price}</span>
                        <span class={`text-[11px] font-bold ${C.sub} group-hover:underline`}>보기 →</span>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="min-w-0 space-y-8">
            {tool && hasSides && (
              <div class="hidden xl:block" aria-hidden="true">
                <p class={`text-3xl md:text-4xl font-black tracking-tight ${C.h1}`}>{cfg.title}</p>
                <p class={`mt-4 leading-relaxed ${C.p}`}>{cfg.intro}</p>
                <p class={`mt-3 text-sm font-bold ${dark ? 'text-amber-300' : 'text-amber-700'}`}>{cfg.disclosure}</p>
              </div>
            )}
            {hub && (
              <div class="grid gap-4 md:grid-cols-2">
                {validTools.map((t: any) => t.builtin && (
                  <a href={`/tools/${t.builtin}`} class={`group block rounded-2xl border p-6 transition ${C.box} ${C.boxHover}`}>
                    <div class={`text-xl font-black ${C.name}`}>{t.title}</div>
                    <p class={`mt-2 text-sm leading-relaxed ${C.sub}`}>{t.desc}</p>
                    <div class={`mt-4 text-sm font-bold ${C.strong} group-hover:underline`}>열기 →</div>
                  </a>
                ))}
              </div>
            )}
            {toolList.map((t: any) => t.builtin === 'planner' ? (
              <PlannerTool cloud={siteConfig?.metadata?.planner_cloud} />
            ) : t.builtin === 'breakeven' ? (
              <BreakEvenTool dark={dark} />
            ) : (
              <div class={`overflow-hidden rounded-2xl border shadow-sm ${C.box}`}>
                <iframe src={t.embed_url} title={t.title} loading="lazy" style={`width:100%;height:${t.height ?? 760}px;border:0;`} allow="clipboard-write"></iframe>
              </div>
            ))}
          </div>

          {hasSides && (
            <div class="hidden xl:block">
              <div class={`${stickyR ? 'sticky top-40 ' : ''}space-y-3`}>
                {cpRight.map((b: any) => (<div class="no-print overflow-hidden rounded-xl"><div class={`mb-1 text-[10px] font-bold ${C.tag}`}>광고 · 쿠팡 파트너스</div><Fragment set:html={cpHtml(b)} /></div>))}
                {rightBanners.map((p) => (
                  <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" data-aff="naver" data-aff-name={p.name} class={`group block overflow-hidden rounded-xl border shadow-sm no-print ${C.box} ${C.boxHover}`}>
                    {safeImg(p.image) && (
                      <img src={safeImg(p.image)} alt={p.name} loading="lazy" decoding="async" referrerpolicy="no-referrer" class="h-[100px] w-full object-cover" />
                    )}
                    <div class="p-3">
                      <div class={`text-[10px] font-bold ${C.tag}`}>광고 · {p.store}</div>
                      <div class={`mt-1 text-xs font-bold leading-snug line-clamp-2 ${C.name}`}>{p.name}</div>
                      <div class="mt-2 flex items-end justify-between gap-1">
                        <span class={`text-sm font-black ${C.strong}`}>{p.price}</span>
                        <span class={`text-[11px] font-bold ${C.sub} group-hover:underline`}>보기 →</span>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        {cpBottom.length > 0 && (
          <div class="mt-8 space-y-4 no-print">
            {cpBottom.map((b: any) => (<div class="flex flex-col items-center overflow-x-auto"><div class={`mb-1 text-[10px] font-bold ${C.tag}`}>광고 · 쿠팡 파트너스</div><Fragment set:html={cpHtml(b)} /></div>))}
          </div>
        )}

        {cfg.free_pack && <FreePack cfg={cfg.free_pack} dark={dark} />}

        {cfg.how?.steps?.length ? (
          <section class={`mt-8 rounded-3xl border p-6 md:p-9 no-print ${dark ? 'border-fuchsia-400/30 bg-gradient-to-br from-fuchsia-500/15 via-violet-500/10 to-sky-500/15' : 'border-fuchsia-200 bg-fuchsia-50'}`} aria-labelledby="how-title">
            <h2 id="how-title" class={`text-2xl md:text-3xl font-black ${C.h1}`}>{cfg.how.title}</h2>
            {cfg.how.lead && <p class={`mt-2 text-sm md:text-base leading-relaxed ${C.p}`}>{cfg.how.lead}</p>}
            <ol class="mt-6 grid gap-4 md:grid-cols-3">
              {cfg.how.steps.slice(0, 6).map((st, i) => (
                <li class={`rounded-2xl border p-5 ${C.box}`}>
                  <div class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-fuchsia-500 to-sky-500 text-sm font-black text-white">{i + 1}</div>
                  <div class={`mt-3 text-base font-black ${C.name}`}>{st.h}</div>
                  <p class={`mt-1 text-sm leading-relaxed ${C.sub}`}>{st.p}</p>
                </li>
              ))}
            </ol>
          </section>
        ) : null}

        {narrowBottom.length > 0 && (
          <div class="mt-8 grid gap-3 sm:grid-cols-2 xl:hidden">
            {narrowBottom.map((p) => (
              <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" data-aff="naver" data-aff-name={p.name} class={`block rounded-xl border p-4 shadow-sm no-print ${C.box} ${C.boxHover}`}>
                <div class={`text-[11px] font-bold ${C.tag}`}>광고 · {p.store}</div>
                <div class={`mt-1 text-sm font-bold leading-snug ${C.name}`}>{p.name}</div>
                <div class={`mt-2 flex items-center justify-between text-xs ${C.sub}`}>
                  <span>확인 시점 가격 <strong class={C.strong}>{p.price}</strong></span>
                  <span class={`font-bold ${C.strong}`}>판매 페이지 →</span>
                </div>
              </a>
            ))}
          </div>
        )}

        {(cpLeft.length + cpRight.length) > 0 && (
          <div class="mt-8 flex flex-wrap justify-center gap-6 xl:hidden no-print">
            {[...cpLeft, ...cpRight].map((b: any) => (<div class="overflow-hidden rounded-xl"><div class={`mb-1 text-[10px] font-bold ${C.tag}`}>광고 · 쿠팡 파트너스</div><Fragment set:html={cpHtml(b)} /></div>))}
          </div>
        )}

        {bottomBanners.length > 0 && (
          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            {bottomBanners.map((p) => (
              <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" data-aff="naver" data-aff-name={p.name} class={`block rounded-xl border p-4 shadow-sm no-print ${C.box} ${C.boxHover}`}>
                <div class={`text-[11px] font-bold ${C.tag}`}>광고 · {p.store}</div>
                <div class={`mt-1 text-sm font-bold leading-snug ${C.name}`}>{p.name}</div>
                <div class={`mt-2 flex items-center justify-between text-xs ${C.sub}`}>
                  <span>확인 시점 가격 <strong class={C.strong}>{p.price}</strong></span>
                  <span class={`font-bold ${C.strong}`}>판매 페이지 →</span>
                </div>
              </a>
            ))}
          </div>
        )}
      </>
    ) : (
      <div class="mt-8 space-y-5">
        {cfg.products.map((p, i) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-5 md:p-6 shadow-sm">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
              <div class="flex-1">
                <div class="text-xs font-bold text-slate-400">{i + 1} · {p.store}</div>
                <h2 class="mt-1 text-lg md:text-xl font-bold text-slate-900 leading-snug">{p.name}</h2>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {p.facts.map((f) => (
                    <li class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">{f}</li>
                  ))}
                </ul>
              </div>
              <div class="md:text-right shrink-0">
                <div class="text-xs text-slate-400">확인 시점 가격</div>
                <div class="text-xl font-black text-slate-900">{p.price}</div>
                <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" data-aff="naver" data-aff-name={p.name} class="mt-3 inline-block rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white hover:bg-slate-700">판매 페이지 보기</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}

    <p class={`mt-8 text-xs leading-relaxed ${C.note}`}>{cfg.notice} 정보 확인일: {cfg.checked_at}.</p>
  </div>
</Layout>

<script is:inline>
  // 우리 사이트의 배너 클릭 기록(GA4 이벤트). 쇼핑 커넥트 통계와 별개의 우리 쪽 데이터다 — 개인 식별 정보는 보내지 않는다.
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest ? e.target.closest('a[data-aff]') : null;
    if (!a || typeof window.gtag !== 'function') return;
    var net = a.getAttribute('data-aff') || 'unknown';
    window.gtag('event', net === 'free_pack' ? 'free_pack_download' : 'affiliate_click', {
      affiliate_network: net,
      item_name: String(a.getAttribute('data-aff-name') || '').slice(0, 100),
      page_path: location.pathname
    });
  }, true);
</script>
