---
import Layout from '../layouts/Layout.astro';
import PlannerTool from './tools/PlannerTool.astro';
import FreePack from './FreePack.astro';
import BreakEvenTool from './tools/BreakEvenTool.astro';
import type { AffiliateHomeConfig } from '../lib/affiliateHome';
interface Props { cfg: AffiliateHomeConfig; siteConfig: any; }
const { cfg, siteConfig } = Astro.props;
const safeHref = (u: string) => (/^https:\/\/(naver\.me|brandconnect\.naver\.com)\//.test(u) ? u : '#');
const safeEmbed = (u: string) => (/^https:\/\/(www\.)?setupod\.com\/embed\/[a-z0-9_-]+(\?[^\s"]*)?$/i.test(u) ? u : '');
const safeImg = (u?: string) => (u && /^https:\/\/[A-Za-z0-9.-]+\/[^\s"'<>]*$/.test(u) ? u : '');
const dark = siteConfig?.metadata?.page_theme === 'dark';
const BUILTIN = ['planner', 'breakeven'];
const rawTools: any[] = cfg.tool?.tools?.length ? cfg.tool.tools : cfg.tool ? [cfg.tool] : [];
const toolList = rawTools.filter((t) => (t.builtin && BUILTIN.includes(t.builtin)) || (t.embed_url && safeEmbed(t.embed_url)));
const tool = toolList.length ? cfg.tool : null;
// 쿠팡 배너: 값만 받아서 우리가 스크립트를 만든다(숫자·정해진 글자만 통과)
const cpOk = (b: any) => /^\d{1,12}$/.test(String(b?.id)) && /^[A-Za-z0-9_-]{1,40}$/.test(String(b?.tracking_code)) && /^\d{2,4}$/.test(String(b?.width)) && /^\d{2,4}$/.test(String(b?.height)) && /^[a-z]{3,20}$/.test(String(b?.template || 'carousel'));
const cpHtml = (b: any) => '<script src="https://ads-partners.coupang.com/g.js"><\/script><script>new PartnersCoupang.G(' + JSON.stringify({ id: Number(b.id), template: b.template || 'carousel', trackingCode: String(b.tracking_code), width: String(b.width), height: String(b.height), tsource: '' }) + ')<\/script>';
const cpBySlot = (slot: string) => (cfg.coupang || []).filter((b: any) => cpOk(b) && (b.slot || 'left') === slot);
const cpLeft = tool ? cpBySlot('left') : [];
const cpRight = tool ? cpBySlot('right') : [];
// 사이트가 어두우면 카드·글자도 어둡게 — 도구가 「남의 것」처럼 보이지 않게 한다
const C = dark
  ? { h1: 'text-white', p: 'text-slate-300', note: 'text-slate-400', box: 'border-slate-700/70 bg-slate-900/60', boxHover: 'hover:border-slate-500', tag: 'text-slate-500', name: 'text-slate-100', sub: 'text-slate-400', strong: 'text-white', warn: 'border-amber-500/30 bg-amber-500/10 text-amber-200' }
  : { h1: 'text-slate-900', p: 'text-slate-600', note: 'text-slate-500', box: 'border-slate-200 bg-white', boxHover: 'hover:border-slate-400', tag: 'text-slate-400', name: 'text-slate-900', sub: 'text-slate-500', strong: 'text-slate-900', warn: 'border-amber-200 bg-amber-50 text-amber-900' };
const topCount = tool ? Math.max(0, Math.min(cfg.products.length, tool.top_count ?? 2)) : 0;
const slotOf = (p: any, i: number) => (p.slot as string) || (i < topCount ? 'top' : 'bottom');
const bySlot = (slot: string) => (tool ? cfg.products.filter((p, i) => slotOf(p, i) === slot) : []);
const topBanners = bySlot('top');
const leftBanners = bySlot('left');
const rightBanners = bySlot('right');
const bottomBanners = bySlot('bottom');
// 폭이 좁으면 옆 배너는 아래로 내려온다(옆 자리는 xl 이상에서만 보인다)
const sideFallback = [...leftBanners, ...rightBanners];
const narrowTop = sideFallback.slice(0, 2);
const narrowBottom = sideFallback.slice(2);
const hasSides = leftBanners.length + rightBanners.length + cpLeft.length + cpRight.length > 0;
---

<Layout title={cfg.title} description={cfg.intro} siteConfig={siteConfig}>
  <div class={`mx-auto px-4 py-6 md:px-6 md:py-10 ${hasSides ? "max-w-[1480px]" : "max-w-4xl"}`}>
    <h1 class={`text-3xl md:text-4xl font-black tracking-tight ${C.h1}`}>{cfg.title}</h1>
    <p class={`mt-4 leading-relaxed ${C.p}`}>{cfg.intro}</p>

    <p class={`mt-3 text-xs no-print ${C.note}`} role="note">ⓘ {cfg.disclosure}</p>

    {tool ? (
      <>
        {topBanners.length > 0 && (
          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            {topBanners.map((p) => (
              <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" class={`block rounded-xl border p-4 shadow-sm no-print ${C.box} ${C.boxHover}`}>
                <div class={`text-[11px] font-bold ${C.tag}`}>광고 · {p.store}</div>
                <div class={`mt-1 text-sm font-bold leading-snug ${C.name}`}>{p.name}</div>
                <div class={`mt-2 flex items-center justify-between text-xs ${C.sub}`}>
                  <span>확인 시점 가격 <strong class={C.strong}>{p.price}</strong></span>
                  <span class={`font-bold ${C.strong}`}>판매 페이지 →</span>
                </div>
              </a>
            ))}
          </div>
        )}

        {narrowTop.length > 0 && (
          <div class="mt-8 grid gap-3 sm:grid-cols-2 xl:hidden">
            {narrowTop.map((p) => (
              <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" class={`block rounded-xl border p-4 shadow-sm no-print ${C.box} ${C.boxHover}`}>
                <div class={`text-[11px] font-bold ${C.tag}`}>광고 · {p.store}</div>
                <div class={`mt-1 text-sm font-bold leading-snug ${C.name}`}>{p.name}</div>
                <div class={`mt-2 flex items-center justify-between text-xs ${C.sub}`}>
                  <span>확인 시점 가격 <strong class={C.strong}>{p.price}</strong></span>
                  <span class={`font-bold ${C.strong}`}>판매 페이지 →</span>
                </div>
              </a>
            ))}
          </div>
        )}

        <div class={`mt-5 ${hasSides ? "xl:grid xl:grid-cols-[170px_minmax(0,1fr)_170px] xl:gap-6" : ""}`}>
          {hasSides && (
            <div class="hidden xl:block">
              <div class="sticky top-40 space-y-3">
                {cpLeft.map((b: any) => (<div class="no-print overflow-hidden rounded-xl"><div class={`mb-1 text-[10px] font-bold ${C.tag}`}>광고 · 쿠팡 파트너스</div><Fragment set:html={cpHtml(b)} /></div>))}
                {leftBanners.map((p) => (
                  <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" class={`group block overflow-hidden rounded-xl border shadow-sm no-print ${C.box} ${C.boxHover}`}>
                    {safeImg(p.image) && (
                      <img src={safeImg(p.image)} alt={p.name} loading="lazy" decoding="async" referrerpolicy="no-referrer" class="h-[100px] w-full object-cover" />
                    )}
                    <div class="p-3">
                      <div class={`text-[10px] font-bold ${C.tag}`}>광고 · {p.store}</div>
                      <div class={`mt-1 text-xs font-bold leading-snug line-clamp-2 ${C.name}`}>{p.name}</div>
                      <div class="mt-2 flex items-end justify-between gap-1">
                        <span class={`text-sm font-black ${C.strong}`}>{p.price}</span>
                        <span class={`text-[11px] font-bold ${C.sub} group-hover:underline`}>보기 →</span>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="min-w-0 space-y-8">
            {toolList.map((t: any) => t.builtin === 'planner' ? (
              <PlannerTool />
            ) : t.builtin === 'breakeven' ? (
              <BreakEvenTool dark={dark} />
            ) : (
              <div class={`overflow-hidden rounded-2xl border shadow-sm ${C.box}`}>
                <iframe src={t.embed_url} title={t.title} loading="lazy" style={`width:100%;height:${t.height ?? 760}px;border:0;`} allow="clipboard-write"></iframe>
              </div>
            ))}
          </div>

          {hasSides && (
            <div class="hidden xl:block">
              <div class="sticky top-40 space-y-3">
                {cpRight.map((b: any) => (<div class="no-print overflow-hidden rounded-xl"><div class={`mb-1 text-[10px] font-bold ${C.tag}`}>광고 · 쿠팡 파트너스</div><Fragment set:html={cpHtml(b)} /></div>))}
                {rightBanners.map((p) => (
                  <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" class={`group block overflow-hidden rounded-xl border shadow-sm no-print ${C.box} ${C.boxHover}`}>
                    {safeImg(p.image) && (
                      <img src={safeImg(p.image)} alt={p.name} loading="lazy" decoding="async" referrerpolicy="no-referrer" class="h-[100px] w-full object-cover" />
                    )}
                    <div class="p-3">
                      <div class={`text-[10px] font-bold ${C.tag}`}>광고 · {p.store}</div>
                      <div class={`mt-1 text-xs font-bold leading-snug line-clamp-2 ${C.name}`}>{p.name}</div>
                      <div class="mt-2 flex items-end justify-between gap-1">
                        <span class={`text-sm font-black ${C.strong}`}>{p.price}</span>
                        <span class={`text-[11px] font-bold ${C.sub} group-hover:underline`}>보기 →</span>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        {cfg.free_pack && <FreePack cfg={cfg.free_pack} dark={dark} />}

        {narrowBottom.length > 0 && (
          <div class="mt-8 grid gap-3 sm:grid-cols-2 xl:hidden">
            {narrowBottom.map((p) => (
              <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" class={`block rounded-xl border p-4 shadow-sm no-print ${C.box} ${C.boxHover}`}>
                <div class={`text-[11px] font-bold ${C.tag}`}>광고 · {p.store}</div>
                <div class={`mt-1 text-sm font-bold leading-snug ${C.name}`}>{p.name}</div>
                <div class={`mt-2 flex items-center justify-between text-xs ${C.sub}`}>
                  <span>확인 시점 가격 <strong class={C.strong}>{p.price}</strong></span>
                  <span class={`font-bold ${C.strong}`}>판매 페이지 →</span>
                </div>
              </a>
            ))}
          </div>
        )}

        {bottomBanners.length > 0 && (
          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            {bottomBanners.map((p) => (
              <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" class={`block rounded-xl border p-4 shadow-sm no-print ${C.box} ${C.boxHover}`}>
                <div class={`text-[11px] font-bold ${C.tag}`}>광고 · {p.store}</div>
                <div class={`mt-1 text-sm font-bold leading-snug ${C.name}`}>{p.name}</div>
                <div class={`mt-2 flex items-center justify-between text-xs ${C.sub}`}>
                  <span>확인 시점 가격 <strong class={C.strong}>{p.price}</strong></span>
                  <span class={`font-bold ${C.strong}`}>판매 페이지 →</span>
                </div>
              </a>
            ))}
          </div>
        )}
      </>
    ) : (
      <div class="mt-8 space-y-5">
        {cfg.products.map((p, i) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-5 md:p-6 shadow-sm">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
              <div class="flex-1">
                <div class="text-xs font-bold text-slate-400">{i + 1} · {p.store}</div>
                <h2 class="mt-1 text-lg md:text-xl font-bold text-slate-900 leading-snug">{p.name}</h2>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {p.facts.map((f) => (
                    <li class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">{f}</li>
                  ))}
                </ul>
              </div>
              <div class="md:text-right shrink-0">
                <div class="text-xs text-slate-400">확인 시점 가격</div>
                <div class="text-xl font-black text-slate-900">{p.price}</div>
                <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" class="mt-3 inline-block rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white hover:bg-slate-700">판매 페이지 보기</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}

    <p class={`mt-8 text-xs leading-relaxed ${C.note}`}>{cfg.notice} 정보 확인일: {cfg.checked_at}.</p>
  </div>
</Layout>
