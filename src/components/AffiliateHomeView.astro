---
import Layout from '../layouts/Layout.astro';
import PlannerTool from './tools/PlannerTool.astro';
import type { AffiliateHomeConfig } from '../lib/affiliateHome';
interface Props { cfg: AffiliateHomeConfig; siteConfig: any; }
const { cfg, siteConfig } = Astro.props;
const safeHref = (u: string) => (/^https:\/\/(naver\.me|brandconnect\.naver\.com)\//.test(u) ? u : '#');
const safeEmbed = (u: string) => (/^https:\/\/(www\.)?setupod\.com\/embed\/[a-z0-9_-]+(\?[^\s"]*)?$/i.test(u) ? u : '');
const dark = siteConfig?.metadata?.page_theme === 'dark';
const tool = cfg.tool && (cfg.tool.builtin === 'planner' || (cfg.tool.embed_url && safeEmbed(cfg.tool.embed_url))) ? cfg.tool : null;
// 사이트가 어두우면 카드·글자도 어둡게 — 도구가 「남의 것」처럼 보이지 않게 한다
const C = dark
  ? { h1: 'text-white', p: 'text-slate-300', note: 'text-slate-400', box: 'border-slate-700/70 bg-slate-900/60', boxHover: 'hover:border-slate-500', tag: 'text-slate-500', name: 'text-slate-100', sub: 'text-slate-400', strong: 'text-white', warn: 'border-amber-500/30 bg-amber-500/10 text-amber-200' }
  : { h1: 'text-slate-900', p: 'text-slate-600', note: 'text-slate-500', box: 'border-slate-200 bg-white', boxHover: 'hover:border-slate-400', tag: 'text-slate-400', name: 'text-slate-900', sub: 'text-slate-500', strong: 'text-slate-900', warn: 'border-amber-200 bg-amber-50 text-amber-900' };
const topCount = tool ? Math.max(0, Math.min(cfg.products.length, tool.top_count ?? 2)) : 0;
const slotOf = (p: any, i: number) => (p.slot as string) || (i < topCount ? 'top' : 'bottom');
const bySlot = (slot: string) => (tool ? cfg.products.filter((p, i) => slotOf(p, i) === slot) : []);
const topBanners = bySlot('top');
const leftBanners = bySlot('left');
const rightBanners = bySlot('right');
const bottomBanners = bySlot('bottom');
// 폭이 좁으면 옆 배너는 아래로 내려온다(옆 자리는 xl 이상에서만 보인다)
const sideFallback = [...leftBanners, ...rightBanners];
const hasSides = leftBanners.length + rightBanners.length > 0;
---

<Layout title={cfg.title} description={cfg.intro} siteConfig={siteConfig}>
  <div class={`mx-auto px-4 py-10 md:px-6 md:py-16 ${hasSides ? "max-w-6xl" : "max-w-4xl"}`}>
    <h1 class={`text-3xl md:text-4xl font-black tracking-tight ${C.h1}`}>{cfg.title}</h1>
    <p class={`mt-4 leading-relaxed ${C.p}`}>{cfg.intro}</p>

    <aside class={`mt-6 rounded-xl border px-4 py-3 text-sm no-print ${C.warn}`} role="note">
      {cfg.disclosure}
    </aside>

    {tool ? (
      <>
        {topBanners.length > 0 && (
          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            {topBanners.map((p) => (
              <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" class={`block rounded-xl border p-4 shadow-sm no-print ${C.box} ${C.boxHover}`}>
                <div class={`text-[11px] font-bold ${C.tag}`}>광고 · {p.store}</div>
                <div class={`mt-1 text-sm font-bold leading-snug ${C.name}`}>{p.name}</div>
                <div class={`mt-2 flex items-center justify-between text-xs ${C.sub}`}>
                  <span>확인 시점 가격 <strong class={C.strong}>{p.price}</strong></span>
                  <span class={`font-bold ${C.strong}`}>판매 페이지 →</span>
                </div>
              </a>
            ))}
          </div>
        )}

        <div class={`mt-8 ${hasSides ? "xl:grid xl:grid-cols-[180px_minmax(0,1fr)_180px] xl:gap-6" : ""}`}>
          {hasSides && (
            <div class="hidden xl:block">
              <div class="sticky top-24 space-y-3">
                {leftBanners.map((p) => (
                  <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" class={`block rounded-xl border p-3 shadow-sm no-print ${C.box} ${C.boxHover}`}>
                    <div class={`text-[11px] font-bold ${C.tag}`}>광고 · {p.store}</div>
                    <div class={`mt-1 text-xs font-bold leading-snug ${C.name}`}>{p.name}</div>
                    <div class={`mt-2 text-xs ${C.sub}`}>확인 시점 가격 <strong class={C.strong}>{p.price}</strong></div>
                    <div class={`mt-2 text-xs font-bold ${C.strong}`}>판매 페이지 →</div>
                  </a>
                ))}
              </div>
            </div>
          )}

          {tool.builtin === 'planner' ? (
            <div class="min-w-0"><PlannerTool /></div>
          ) : (
            <div class={`overflow-hidden rounded-2xl border shadow-sm ${C.box}`}>
              <iframe
                src={tool.embed_url}
                title={tool.title}
                loading="lazy"
                style={`width:100%;height:${tool.height ?? 760}px;border:0;`}
                allow="clipboard-write"
              ></iframe>
            </div>
          )}

          {hasSides && (
            <div class="hidden xl:block">
              <div class="sticky top-24 space-y-3">
                {rightBanners.map((p) => (
                  <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" class={`block rounded-xl border p-3 shadow-sm no-print ${C.box} ${C.boxHover}`}>
                    <div class={`text-[11px] font-bold ${C.tag}`}>광고 · {p.store}</div>
                    <div class={`mt-1 text-xs font-bold leading-snug ${C.name}`}>{p.name}</div>
                    <div class={`mt-2 text-xs ${C.sub}`}>확인 시점 가격 <strong class={C.strong}>{p.price}</strong></div>
                    <div class={`mt-2 text-xs font-bold ${C.strong}`}>판매 페이지 →</div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        {sideFallback.length > 0 && (
          <div class="mt-8 grid gap-3 sm:grid-cols-2 xl:hidden">
            {sideFallback.map((p) => (
              <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" class={`block rounded-xl border p-4 shadow-sm no-print ${C.box} ${C.boxHover}`}>
                <div class={`text-[11px] font-bold ${C.tag}`}>광고 · {p.store}</div>
                <div class={`mt-1 text-sm font-bold leading-snug ${C.name}`}>{p.name}</div>
                <div class={`mt-2 flex items-center justify-between text-xs ${C.sub}`}>
                  <span>확인 시점 가격 <strong class={C.strong}>{p.price}</strong></span>
                  <span class={`font-bold ${C.strong}`}>판매 페이지 →</span>
                </div>
              </a>
            ))}
          </div>
        )}

        {bottomBanners.length > 0 && (
          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            {bottomBanners.map((p) => (
              <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" class={`block rounded-xl border p-4 shadow-sm no-print ${C.box} ${C.boxHover}`}>
                <div class={`text-[11px] font-bold ${C.tag}`}>광고 · {p.store}</div>
                <div class={`mt-1 text-sm font-bold leading-snug ${C.name}`}>{p.name}</div>
                <div class={`mt-2 flex items-center justify-between text-xs ${C.sub}`}>
                  <span>확인 시점 가격 <strong class={C.strong}>{p.price}</strong></span>
                  <span class={`font-bold ${C.strong}`}>판매 페이지 →</span>
                </div>
              </a>
            ))}
          </div>
        )}
      </>
    ) : (
      <div class="mt-8 space-y-5">
        {cfg.products.map((p, i) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-5 md:p-6 shadow-sm">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
              <div class="flex-1">
                <div class="text-xs font-bold text-slate-400">{i + 1} · {p.store}</div>
                <h2 class="mt-1 text-lg md:text-xl font-bold text-slate-900 leading-snug">{p.name}</h2>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {p.facts.map((f) => (
                    <li class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">{f}</li>
                  ))}
                </ul>
              </div>
              <div class="md:text-right shrink-0">
                <div class="text-xs text-slate-400">확인 시점 가격</div>
                <div class="text-xl font-black text-slate-900">{p.price}</div>
                <a href={safeHref(p.url)} target="_blank" rel="sponsored nofollow noopener noreferrer" class="mt-3 inline-block rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white hover:bg-slate-700">판매 페이지 보기</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}

    <p class={`mt-8 text-xs leading-relaxed ${C.note}`}>{cfg.notice} 정보 확인일: {cfg.checked_at}.</p>
  </div>
</Layout>
