---
import { Search } from 'lucide-astro';
import { generateThemeVars } from '../lib/theme';
import { getCategoryLabel } from '../lib/categories';

interface Props {
  siteConfig?: any;
  categories?: string[];
  currentLang?: string;
}

const { siteConfig = null, categories = [], currentLang = 'ko' } = Astro.props;
const blogName = siteConfig?.blog_name || "Maza Blog";
const theme = generateThemeVars(siteConfig);

const NAV_LABELS: Record<string, { menu: string; home: string; about: string; contact: string }> = {
  ko: { menu: '메뉴', home: '홈', about: '소개', contact: '문의' },
  en: { menu: 'Menu', home: 'Home', about: 'About', contact: 'Contact' },
  ja: { menu: 'メニュー', home: 'ホーム', about: '概要', contact: 'お問い合わせ' },
};
const navLabels = NAV_LABELS[currentLang] || NAV_LABELS.en;

const darkBg = theme.isPremium
  ? (theme.headerDarkMode 
      ? 'bg-slate-900/80 border-slate-800/50 text-white backdrop-blur-xl shadow-lg shadow-black/10' 
      : 'bg-white/70 border-white/50 text-slate-900 backdrop-blur-xl shadow-sm ring-1 ring-slate-900/5')
  : (theme.headerDarkMode
      ? 'bg-slate-900 border-slate-800 text-white'
      : 'bg-white border-slate-200 text-slate-900');
const textNav = theme.headerDarkMode ? 'text-slate-300' : 'text-slate-600';
---

{theme.headerTopBar && (
  <div class={`w-full ${theme.headerDarkMode ? 'bg-indigo-900 text-indigo-100' : 'bg-[var(--color-indigo-600)] text-indigo-50'} py-2 text-center text-xs font-bold tracking-wider uppercase`}>
    Welcome to {blogName}
  </div>
)}

{/* [MOBILE NAV] 기존 네비게이션은 4가지 변형 전부 `hidden md:flex`라
    모바일에서 메뉴가 통째로 사라졌고 햄버거도 없었다. 애드센스 심사는
    모바일 우선이라 치명적이다(라이브 감사에서 확인).
    변형마다 손대면 깨지기 쉬우므로, 모바일 전용 메뉴를 하나만 추가한다.
    <details>를 쓰면 JS 없이 열고 닫히므로 SSR에서 깨질 여지가 없다. */}
<details class={`md:hidden w-full border-b ${darkBg} group`}>
  <summary class={`flex items-center justify-between px-6 py-3 cursor-pointer list-none ${textNav}`}>
    <span class="text-sm font-bold">{navLabels.menu}</span>
    <svg class="h-5 w-5 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
    </svg>
  </summary>
  <nav class={`flex flex-col gap-1 px-6 pb-4 text-sm font-semibold ${textNav}`}>
    <a href="/" class="py-2 hover:text-[var(--color-indigo-600)]">{navLabels.home}</a>
    {categories.map((cat: string) => (
      <a href={`/category/${encodeURIComponent(cat)}`} class="py-2 hover:text-[var(--color-indigo-600)]">{getCategoryLabel(cat, currentLang)}</a>
    ))}
    <a href="/about" class="py-2 hover:text-[var(--color-indigo-600)]">{navLabels.about}</a>
    <a href="/contact" class="py-2 hover:text-[var(--color-indigo-600)]">{navLabels.contact}</a>
  </nav>
</details>

<header class={`sticky top-0 z-50 w-full border-b transition-all ${darkBg} ${theme.paddingY}`}>
  <div class={`mx-auto flex flex-col md:flex-row items-center justify-between px-6 gap-4 ${theme.layoutWidth} ${theme.headerMenuPos === 'bottom' ? 'md:flex-col' : ''}`}>
    
    {theme.headerLogoPos === 'left' && theme.headerMenuPos !== 'bottom' && (
      <div class="flex-1 flex justify-start min-w-0">
        <a href="/" class="flex items-center gap-2 min-w-0">
          <div class={`flex h-8 w-8 shrink-0 items-center justify-center ${theme.borderRadius} bg-[var(--color-indigo-600)] text-white font-bold shadow-lg shadow-[var(--color-indigo-200)]`}>{blogName.charAt(0).toUpperCase()}</div>
          <span class="text-xl font-black italic tracking-tight md:whitespace-nowrap md:shrink-0 min-w-0 truncate block">{blogName}</span>
        </a>
      </div>
    )}

    {theme.headerLogoPos === 'center' && theme.headerMenuPos !== 'bottom' && (
      <div class="flex-1 flex justify-start">
        <nav class={`hidden md:flex items-center gap-6 text-sm font-semibold ${textNav}`}>
          <a href="/" class="hover:text-[var(--color-indigo-600)]">{navLabels.home}</a>
          {categories.map((cat: string) => (<a href={`/category/${encodeURIComponent(cat)}`} class="hover:text-[var(--color-indigo-600)]">{getCategoryLabel(cat, currentLang)}</a>))}
          <a href="/about" class="hover:text-[var(--color-indigo-600)]">{navLabels.about}</a>
          <a href="/contact" class="hover:text-[var(--color-indigo-600)]">{navLabels.contact}</a>
        </nav>
      </div>
    )}

    {theme.headerLogoPos === 'center' && theme.headerMenuPos !== 'bottom' && (
      <div class="flex-none min-w-0 max-w-full">
        <a href="/" class="flex items-center gap-2 min-w-0">
          <span class="text-2xl font-black uppercase tracking-tighter text-[var(--color-indigo-600)] md:whitespace-nowrap md:shrink-0 min-w-0 truncate block">{blogName}</span>
        </a>
      </div>
    )}

    {theme.headerLogoPos === 'left' && theme.headerMenuPos !== 'bottom' && (
      <div class={`flex-auto flex ${theme.headerMenuPos === 'right' ? 'justify-end pr-8' : 'justify-center'}`}>
        <nav class={`hidden md:flex items-center gap-6 text-sm font-semibold ${textNav}`}>
          <a href="/" class="hover:text-[var(--color-indigo-600)]">{navLabels.home}</a>
          {categories.map((cat: string) => (<a href={`/category/${encodeURIComponent(cat)}`} class="hover:text-[var(--color-indigo-600)]">{getCategoryLabel(cat, currentLang)}</a>))}
          <a href="/about" class="hover:text-[var(--color-indigo-600)]">{navLabels.about}</a>
          <a href="/contact" class="hover:text-[var(--color-indigo-600)]">{navLabels.contact}</a>
        </nav>
      </div>
    )}

    {theme.headerLogoPos === 'right' && theme.headerMenuPos !== 'bottom' && (
      <>
        <div class="flex-1 flex justify-start gap-8">
          <nav class={`hidden md:flex items-center gap-6 text-sm font-semibold ${textNav}`}>
            <a href="/" class="hover:text-[var(--color-indigo-600)]">{navLabels.home}</a>
            {categories.map((cat: string) => (<a href={`/category/${encodeURIComponent(cat)}`} class="hover:text-[var(--color-indigo-600)]">{getCategoryLabel(cat, currentLang)}</a>))}
            <a href="/about" class="hover:text-[var(--color-indigo-600)]">{navLabels.about}</a>
            <a href="/contact" class="hover:text-[var(--color-indigo-600)]">{navLabels.contact}</a>
          </nav>
        </div>
        <div class="flex-none min-w-0 max-w-full">
          <a href="/" class="flex items-center gap-2 text-xl font-black md:whitespace-nowrap md:shrink-0 min-w-0 truncate">{blogName}</a>
        </div>
      </>
    )}

    {theme.headerMenuPos !== 'bottom' && (
      <div class="flex-1 flex justify-end items-center gap-4">
        <div class="hidden sm:flex items-center gap-2 text-xs font-semibold text-slate-500">
          <a href="/" class={currentLang === 'ko' ? 'text-[var(--color-indigo-600)]' : ''}>KR</a>
          <span>|</span>
          <a href="/en" class={currentLang === 'en' ? 'text-[var(--color-indigo-600)]' : ''}>EN</a>
        </div>
        <button class="p-2 text-slate-400 hover:text-[var(--color-indigo-600)] transition-colors"><Search size={20} /></button>
      </div>
    )}

    {theme.headerMenuPos === 'bottom' && (
      <>
        <div class="w-full flex justify-between items-center">
          {theme.headerLogoPos === 'center' ? <div class="flex-1"></div> : null}
          <a href="/" class={`flex items-center gap-2 text-2xl font-black md:whitespace-nowrap md:shrink-0 min-w-0 truncate ${theme.headerLogoPos === 'right' ? 'ml-auto' : ''}`}>
            {blogName}
          </a>
          <div class={`flex-1 flex justify-end gap-4`}>
            <button class="p-2 text-slate-400"><Search size={20} /></button>
          </div>
        </div>
        <div class={`w-full flex ${theme.headerLogoPos === 'center' ? 'justify-center' : 'justify-start'} border-t ${theme.headerDarkMode ? 'border-slate-800' : 'border-slate-100'} pt-4 mt-2`}>
          <nav class={`hidden md:flex items-center gap-8 text-sm font-semibold ${textNav}`}>
            <a href="/" class="hover:text-[var(--color-indigo-600)]">{navLabels.home}</a>
            {categories.map((cat: string) => (<a href={`/category/${encodeURIComponent(cat)}`} class="hover:text-[var(--color-indigo-600)]">{getCategoryLabel(cat, currentLang)}</a>))}
            <a href="/about" class="hover:text-[var(--color-indigo-600)]">{navLabels.about}</a>
            <a href="/contact" class="hover:text-[var(--color-indigo-600)]">{navLabels.contact}</a>
          </nav>
        </div>
      </>
    )}

  </div>
</header>
