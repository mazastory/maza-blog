---
import { getLangFromEnv, useTranslations } from '../i18n/utils';
const lang = getLangFromEnv();
const t = useTranslations(lang);

interface Props {
  siteId?: string;
  domain?: string;
}

const { siteId, domain } = Astro.props;
---

<div class="newsletter-wrapper bg-slate-900 text-white rounded-2xl p-8 my-12 shadow-xl border border-slate-800 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/20 to-purple-600/20 pointer-events-none"></div>
  
  <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
    <div class="flex-1">
      <h3 class="text-2xl font-bold mb-2">Subscribe to our Newsletter</h3>
      <p class="text-slate-300">Get the latest insights and articles delivered straight to your inbox. No spam, ever.</p>
    </div>
    
    <div class="w-full md:w-auto">
      <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3 w-full max-w-md">
        <input 
          type="hidden" 
          id="nl-site-id" 
          value={siteId || ''} 
        />
        <input 
          type="hidden" 
          id="nl-domain" 
          value={domain || ''} 
        />
        <input 
          type="email" 
          id="nl-email" 
          placeholder="your@email.com" 
          required
          class="flex-1 px-4 py-3 rounded-lg bg-slate-800 border border-slate-700 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all"
        />
        <button 
          type="submit"
          id="nl-submit"
          class="px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-slate-900 disabled:opacity-70 flex items-center justify-center min-w-[120px]"
        >
          <span>Subscribe</span>
        </button>
      </form>
      <div id="nl-message" class="mt-3 text-sm hidden"></div>
    </div>
  </div>
</div>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  const emailInput = document.getElementById('nl-email') as HTMLInputElement;
  const siteIdInput = document.getElementById('nl-site-id') as HTMLInputElement;
  const domainInput = document.getElementById('nl-domain') as HTMLInputElement;
  const submitBtn = document.getElementById('nl-submit') as HTMLButtonElement;
  const messageEl = document.getElementById('nl-message') as HTMLDivElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const email = emailInput.value.trim();
      if (!email) return;

      const siteId = siteIdInput.value;
      const domain = domainInput.value || window.location.hostname;
      const apiUrl = window.location.hostname === 'localhost' || window.location.hostname.includes('127.0.0.1')
        ? 'http://localhost:3001/api/newsletter/subscribe'
        : 'https://api.mazastudio.kr/api/newsletter/subscribe';

      submitBtn.disabled = true;
      submitBtn.innerHTML = `<svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;
      messageEl.classList.add('hidden');
      messageEl.className = 'mt-3 text-sm hidden';

      try {
        const response = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, siteId, domain })
        });

        const data = await response.json();

        messageEl.classList.remove('hidden');
        if (data.success) {
          messageEl.textContent = 'Thanks for subscribing! 🎉';
          messageEl.classList.add('text-emerald-400');
          emailInput.value = '';
        } else {
          messageEl.textContent = data.error || 'Something went wrong. Please try again.';
          messageEl.classList.add('text-red-400');
        }
      } catch (err) {
        messageEl.classList.remove('hidden');
        messageEl.textContent = 'Network error. Please try again.';
        messageEl.classList.add('text-red-400');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>Subscribe</span>';
      }
    });
  }
</script>
