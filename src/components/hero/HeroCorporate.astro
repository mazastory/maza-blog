---
import PostCard from '../PostCard.astro';
import { Search, ArrowRight } from 'lucide-astro';

export interface Props {
  /**
   * [2026-08-27] `theme` 을 Props 에 추가했다.
   * index.astro 는 7개 템플릿 전부에 theme 을 넘기는데 이 파일은 선언도 사용도
   * 하지 않아서, 타입은 에러였고 **사이트 테마가 실제로 안 먹었다**(HeroModern·
   * HeroClassic 만 적용 중이었다). 현재 12개 사이트는 전부 hero_template 미설정 →
   * modern 폴백이라 화면에 드러난 적은 없다.
   * 아래 `--brand-color` 로 강조색만 우선 연결했다. 나머지 색까지 테마화하는 것은
   * 별도 작업이다.
   */
  theme?: any;
  blogName: string;
  blogDescription: string;
  heroBgUrl?: string | null;
  t: any;
  posts: any[];
  heroSubtitle: string;
  categories?: string[];
}
const { theme, blogName, blogDescription, heroBgUrl, t, posts, heroSubtitle, categories = [] } = Astro.props;

let bgImg = heroBgUrl || '/hero-bg-picasso.png';
if (!heroBgUrl && posts.length > 0) {
  const metaImg = posts[0].metadata?.data?.image1 
    || posts[0].metadata?.blocks?.find((b: any) => b.type === 'image')?.url
    || posts[0].metadata?.thumbnail_url
    || posts[0].thumbnail_url
    || null;
  if (metaImg) bgImg = metaImg;
}

const featuredPost = posts.length > 0 ? posts[0] : null;
const recentPosts = posts.slice(1, 3); // Get 2 posts for the bottom section
---

<div style={`--brand-color: ${theme?.color || '#4f46e5'}`} class="flex flex-col lg:flex-row min-h-screen w-full bg-white font-sans text-slate-900">
  
  {/* Left Panel - Image */}
  <div class="relative w-full lg:w-1/2 min-h-[50vh] lg:min-h-screen">
    <img src={bgImg} alt={blogName} class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/20"></div>
    
    {/* Logo Overlay */}
    <div class="absolute top-0 left-0 p-8 lg:p-12 z-10">
      <h1 class="text-3xl lg:text-4xl font-black text-white tracking-widest uppercase font-serif drop-shadow-md">
        {blogName}
      </h1>
      <p class="text-white/90 text-sm tracking-[0.2em] uppercase mt-2 drop-shadow">
        {heroSubtitle || blogDescription.substring(0, 30)}
      </p>
    </div>
  </div>

  {/* Right Panel - Content */}
  <div class="w-full lg:w-1/2 flex flex-col justify-between p-8 lg:p-16 relative">
    
    {/* Top Navigation */}
    <nav class="flex flex-wrap items-center justify-between lg:justify-start gap-x-8 gap-y-4 pb-6 border-b border-slate-200">
      <div class="flex items-center gap-6 text-sm font-bold tracking-widest text-slate-600 uppercase">
        {categories.slice(0, 4).map(cat => (
          <a href={`/category/${encodeURIComponent(cat)}`} class="hover:text-[var(--color-indigo-600)] transition-colors">{cat}</a>
        ))}
        <a href="/about" class="hover:text-[var(--color-indigo-600)] transition-colors">About</a>
      </div>
      <button class="lg:ml-auto flex items-center gap-2 text-sm font-bold tracking-widest text-slate-600 uppercase hover:text-[var(--color-indigo-600)] transition-colors">
        Search <Search size={16} />
      </button>
    </nav>

    {/* Main Headline Area */}
    <div class="flex-1 flex flex-col justify-center py-16 lg:py-20">
      <h2 class="text-4xl lg:text-5xl font-black font-serif text-slate-900 leading-[1.2] mb-8 break-keep">
        {heroSubtitle || blogDescription}
      </h2>
      <p class="text-xl text-slate-600 leading-relaxed max-w-lg mb-10 break-keep">
        {blogDescription}
      </p>
      
      {featuredPost ? (
        <a href={`/${featuredPost.slug || featuredPost.id}`} class="inline-flex items-center gap-3 bg-indigo-600 text-white px-8 py-4 rounded-full font-bold text-sm tracking-widest uppercase hover:bg-indigo-700 transition-colors self-start shadow-lg shadow-indigo-600/30">
          {t.readArticle || 'EXPLORE STORIES'} <ArrowRight size={18} />
        </a>
      ) : (
        <a href="/about" class="inline-flex items-center gap-3 bg-indigo-600 text-white px-8 py-4 rounded-full font-bold text-sm tracking-widest uppercase hover:bg-indigo-700 transition-colors self-start shadow-lg shadow-indigo-600/30">
          {t.about || 'ABOUT US'} <ArrowRight size={18} />
        </a>
      )}
    </div>

    {/* Bottom Section - Recent Posts */}
    {recentPosts.length > 0 && (
      <div class="mt-auto">
        <div class="flex items-center gap-4 mb-6">
          <h3 class="text-xl font-black font-serif text-slate-900 uppercase">{t.recentArticles || 'LATEST'}</h3>
          <div class="h-px bg-slate-200 flex-1"></div>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          {recentPosts.map((post: any) => {
            const metaImg = post.metadata?.data?.image1 
              || post.metadata?.blocks?.find((b: any) => b.type === 'image')?.url
              || post.metadata?.thumbnail_url
              || post.thumbnail_url;
              
            return (
              <a href={`/${post.slug || post.id}`} class="group flex flex-col gap-3">
                {metaImg && (
                  <div class="aspect-[4/3] w-full overflow-hidden bg-slate-100">
                    <img src={metaImg} alt={post.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                  </div>
                )}
                <div>
                  <span class="text-xs font-bold text-purple-600 tracking-wider uppercase mb-1 block">
                    {post.metadata?.category || "ARTICLE"}
                  </span>
                  <h4 class="font-bold text-slate-900 leading-snug group-hover:text-purple-600 transition-colors line-clamp-2">
                    {post.title}
                  </h4>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}

  </div>
</div>

<style>
  /* Import Playfair Display for the serif headers to match the design */
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&display=swap');
  
  .font-serif {
    font-family: 'Playfair Display', serif;
  }
</style>
