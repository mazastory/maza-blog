---
/**
 * 무료 자료 받기 띠 (2026-10-14, sharpinsighthub.com).
 * 흐름: 이메일 + [필수] 동의 → /api/free-pack 이 저장(투머스 DB) → **저장이 확인되면** 내려받기 버튼이 열린다.
 * 문구·파일은 사이트 설정(`affiliate_home.free_pack`)에서 오고, 파일은 `/downloads/*.pdf` 만 허용한다.
 * 이메일은 브라우저에 남기지 않는다(「이미 신청했다」는 표시만 이 브라우저에 둔다).
 */
interface FreePackItem { title: string; desc: string; file: string; pages?: number; size?: string; }
interface FreePackConfig { title: string; lead: string; items: FreePackItem[]; operator?: string; contact?: string; }
interface Props { cfg: FreePackConfig; dark: boolean; }
const { cfg, dark } = Astro.props;
const safeFile = (f: string) => (/^\/downloads\/[A-Za-z0-9._-]+\.pdf$/.test(f) ? f : '');
const items = (cfg.items || []).filter((i) => safeFile(i.file)).slice(0, 6);
const T = dark
  ? { box: 'border-sky-500/30 bg-gradient-to-br from-sky-500/10 to-indigo-500/10', h: 'text-white', p: 'text-slate-300', card: 'border-slate-700/70 bg-slate-900/60', name: 'text-slate-100', sub: 'text-slate-400', input: 'border-slate-600 bg-slate-950/60 text-white placeholder-slate-500', btn: 'bg-sky-500 text-white hover:bg-sky-400', link: 'border-sky-400/40 bg-sky-500/10 text-sky-200 hover:bg-sky-500/20', note: 'text-slate-400', err: 'text-rose-300' }
  : { box: 'border-sky-200 bg-sky-50', h: 'text-slate-900', p: 'text-slate-600', card: 'border-slate-200 bg-white', name: 'text-slate-900', sub: 'text-slate-500', input: 'border-slate-300 bg-white text-slate-900 placeholder-slate-400', btn: 'bg-slate-900 text-white hover:bg-slate-700', link: 'border-sky-300 bg-white text-sky-800 hover:bg-sky-50', note: 'text-slate-500', err: 'text-rose-700' };
---
{items.length > 0 && (
  <section id="free-pack" class={`mt-8 rounded-2xl border p-5 md:p-7 no-print ${T.box}`} aria-labelledby="free-pack-title">
    <div class="md:flex md:items-start md:justify-between md:gap-8">
      <div class="md:max-w-md">
        <div class={`text-[11px] font-bold tracking-wider ${T.sub}`}>FREE PDF</div>
        <h2 id="free-pack-title" class={`mt-1 text-xl md:text-2xl font-black ${T.h}`}>{cfg.title}</h2>
        <p class={`mt-2 text-sm leading-relaxed ${T.p}`}>{cfg.lead}</p>

        <form id="fp-form" class="mt-4" novalidate>
          <label for="fp-email" class={`block text-xs font-bold ${T.sub}`}>이메일 주소</label>
          <div class="mt-1 flex gap-2">
            <input id="fp-email" type="email" inputmode="email" autocomplete="email" maxlength="254" required placeholder="name@example.com"
              class={`min-w-0 flex-1 rounded-lg border px-3 py-2.5 text-sm outline-none focus:ring-2 focus:ring-sky-400 ${T.input}`} />
            <button id="fp-submit" type="submit" class={`shrink-0 rounded-lg px-4 py-2.5 text-sm font-bold transition ${T.btn} disabled:opacity-50`}>받기</button>
          </div>
          <label class={`mt-3 flex items-start gap-2 text-xs leading-relaxed ${T.p}`}>
            <input id="fp-consent" type="checkbox" class="mt-0.5 h-4 w-4 shrink-0" />
            <span>[필수] 개인정보 수집·이용에 동의합니다. <a href="#fp-detail" id="fp-more" class="underline">자세히</a></span>
          </label>
          <label class={`mt-2 flex items-start gap-2 text-xs leading-relaxed ${T.p}`}>
            <input id="fp-marketing" type="checkbox" class="mt-0.5 h-4 w-4 shrink-0" />
            <span>[선택] 새 무료 자료와 소식을 이메일로 받겠습니다. (체크하지 않아도 자료는 받을 수 있습니다)</span>
          </label>
          <div id="fp-detail" class={`mt-3 hidden rounded-lg border p-3 text-xs leading-relaxed ${T.card} ${T.p}`}>
            <p><strong>수집하는 항목</strong> 이메일 주소</p>
            <p class="mt-1"><strong>이용 목적</strong> 신청하신 무료 자료의 제공, 신청 건수 같은 이용 현황 집계. [선택]에 체크하신 경우에 한해 새 자료·소식 안내.</p>
            <p class="mt-1"><strong>보유 기간</strong> 신청일로부터 2년 뒤 자동 삭제합니다. 그 전이라도 삭제나 동의 철회를 요청하시면 영업일 7일 이내에 삭제합니다.</p>
            <p class="mt-1"><strong>동의 거부</strong> 동의하지 않으셔도 사이트(플래너)는 쓰실 수 있습니다. 다만 이 자료는 받으실 수 없습니다.</p>
            <p class="mt-1"><strong>수집·관리</strong> {cfg.operator || '투머스'}{cfg.contact ? ` · 문의 ${cfg.contact}` : ''} · 자세한 내용은 <a class="underline" href="/privacy">개인정보처리방침</a></p>
          </div>
          <p id="fp-error" role="alert" class={`mt-2 hidden text-xs font-bold ${T.err}`}></p>
        </form>
      </div>

      <div class="mt-5 md:mt-0 md:flex-1 md:max-w-md">
        <ul class="space-y-2">
          {items.map((it) => (
            <li class={`flex items-center justify-between gap-3 rounded-xl border p-3 ${T.card}`}>
              <div class="min-w-0">
                <div class={`truncate text-sm font-bold ${T.name}`}>{it.title}</div>
                <div class={`text-xs ${T.sub}`}>{it.desc}{it.pages ? ` · ${it.pages}쪽` : ''}{it.size ? ` · ${it.size}` : ''}</div>
              </div>
              <a data-fp-file={safeFile(it.file)} aria-disabled="true" tabindex="-1" class={`fp-dl pointer-events-none shrink-0 rounded-lg border px-3 py-1.5 text-xs font-bold opacity-40 ${T.link}`}>PDF</a>
            </li>
          ))}
        </ul>
        <p id="fp-status" class={`mt-2 text-xs ${T.note}`}>이메일을 입력하고 동의하시면 내려받기 버튼이 열립니다.</p>
      </div>
    </div>
  </section>
)}

<script is:inline>
(function () {
  var form = document.getElementById('fp-form');
  if (!form) return;
  var KEY = 'fp_requested_v1';
  var $ = function (id) { return document.getElementById(id); };
  var err = $('fp-error'), status = $('fp-status'), btn = $('fp-submit');
  var EMAIL_RE = /^[A-Za-z0-9][A-Za-z0-9._%+-]{0,63}@[A-Za-z0-9.-]{1,255}\.[A-Za-z]{2,}$/;
  function unlock() {
    document.querySelectorAll('.fp-dl').forEach(function (a) {
      a.setAttribute('href', a.getAttribute('data-fp-file'));
      a.setAttribute('download', '');
      a.removeAttribute('aria-disabled'); a.removeAttribute('tabindex');
      a.classList.remove('pointer-events-none', 'opacity-40');
    });
    status.textContent = '아래 버튼으로 내려받으실 수 있습니다.';
  }
  function show(msg) { err.textContent = msg; err.classList.remove('hidden'); }
  try { if (localStorage.getItem(KEY) === '1') { unlock(); status.textContent = '이미 신청하셨습니다. 아래 버튼으로 내려받으실 수 있습니다.'; } } catch (e) {}
  $('fp-more').addEventListener('click', function (e) { e.preventDefault(); $('fp-detail').classList.toggle('hidden'); });
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    err.classList.add('hidden');
    var email = $('fp-email').value.trim().toLowerCase();
    if (!EMAIL_RE.test(email) || email.length > 254) return show('이메일 주소를 확인해 주세요.');
    if (!$('fp-consent').checked) return show('[필수] 개인정보 수집·이용에 동의해 주셔야 자료를 받으실 수 있습니다.');
    btn.disabled = true; btn.textContent = '확인 중…';
    fetch('/api/free-pack', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email, consent: true, marketing_opt_in: $('fp-marketing').checked })
    }).then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (x) {
        if (x.ok && x.j && x.j.success) {
          try { localStorage.setItem(KEY, '1'); } catch (e) {}
          $('fp-email').value = '';
          unlock();
        } else if (x.j && x.j.error === 'Too many requests') show('잠시 뒤에 다시 시도해 주세요.');
        else show('신청을 저장하지 못했습니다. 잠시 뒤에 다시 시도해 주세요.');
      })
      .catch(function () { show('연결하지 못했습니다. 잠시 뒤에 다시 시도해 주세요.'); })
      .then(function () { btn.disabled = false; btn.textContent = '받기'; });
  });
})();
</script>
