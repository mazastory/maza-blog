---
import '../styles/global.css';
import Header from '../components/Header.astro';
import SEO from '../components/SEO.astro';
import Schema from '../components/Schema.astro';
import DynamicTheme from '../components/DynamicTheme.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { getSiteConfig, getRequestDomain, getApprovedPosts } from '../lib/api';
import { generateThemeVars } from '../lib/theme';
import { ClientRouter } from 'astro:transitions';
import { getLangFromEnv, useTranslations } from '../i18n/utils';

const lang = getLangFromEnv();
const t = useTranslations(lang);

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	authorName?: string;
	datePublished?: string;
  preloadImage?: string;
  siteConfig?: any;
  hideHeader?: boolean;
}

const domain = getRequestDomain(Astro.request);

const isToomus = domain.includes('autosite.kr') || domain.includes('maza.ai.kr') || domain.includes('toomus');
const isCanDoKorea = domain.includes('mazastory.com') || domain.includes('mazaus.com');

let companyInfo = null;

if (isToomus) {
  companyInfo = {
    name: '투머스 (Toomus)',
    ceo: '김민호',
    regNum: '604-30-53081',
    ecommerce: '통신판매업 신고 완료',
    email: 'metasoseono@gmail.com',
    address: '경기도 광주시 새말길317번길 19, B동 103호'
  };
} else if (isCanDoKorea) {
  companyInfo = {
    name: '캔두코리아 (MAZA Studio)',
    ceo: '조윤서',
    regNum: '885-32-01361',
    ecommerce: '제 2023-성남분당A-0874 호',
    email: 'metasoseono@gmail.com',
    address: '경기 성남시 분당구 대왕판교로645번길 12, 7층 44호'
  };
}

const siteConfig = Astro.props.siteConfig || await getSiteConfig(domain);
const theme = generateThemeVars(siteConfig);

const defaultImages = [
  'https://images.unsplash.com/photo-1499750310107-5fef28a66643?q=80&w=1200&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1519389953815-46b7fc64a504?q=80&w=1200&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1432821596592-e2c18b78144f?q=80&w=1200&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1557683316-973673baf926?q=80&w=1200&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=1200&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?q=80&w=1200&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=1200&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1451187580459-43490279c0fa?q=80&w=1200&auto=format&fit=crop'
];
// [FIX] Anti-Footprint: 단순 덧셈 해시가 아닌 비트 연산 기반의 강력한 해싱으로 OG 이미지가 겹치는 현상 차단
const domainHash = Math.abs(domain.split('').reduce((acc, char) => (acc << 5) - acc + char.charCodeAt(0), 0));
const fallbackImage = defaultImages[domainHash % defaultImages.length];

const allPosts = await getApprovedPosts(domain, Astro.locals.lang);
let uniqueCategories = Array.from(new Set(allPosts.map(p => p.metadata?.category).filter(Boolean)));
if (uniqueCategories.length === 0) {
  uniqueCategories.push(siteConfig?.metadata?.primary_topic_ko || 'Trend');
}

// [MAZA 50-Point QC] 애드센스 승인 심사 중인 사이트(Topical Authority 강제)의 경우 메인 카테고리 1개만 노출
if (siteConfig?.purpose === 'adsense' && siteConfig?.adsense_status !== 'approved') {
  const primaryCategory = siteConfig?.metadata?.primary_topic_ko || uniqueCategories[0] || 'GENERAL';
  uniqueCategories = [primaryCategory];
}
// 각 페이지에서 캐시 설정을 관리합니다 (Layout에서는 중복 설정하지 않음)
const siteTitle = siteConfig?.blog_name || "Maza Blog";
const siteDesc = siteConfig?.niche || "MazaStudio Subdomain Blog - High Quality AI Content";

const { 
	title, 
	description = siteDesc, 
	image, 
	type = 'website',
	authorName = siteTitle,
	datePublished,
	preloadImage = undefined,
  hideHeader = false
} = Astro.props;

const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
let path = Astro.url.pathname;
if (path !== '/' && path.endsWith('/')) {
  path = path.slice(0, -1);
}
const canonicalUrl = new URL(path, `https://${siteConfig?.domain || domain}`).href;

const rawSc = siteConfig?.sc_verification || siteConfig?.metadata?.google_site_verification || '';
let scContent = rawSc;
if (rawSc) {
  const match = rawSc.match(/content="([^"]+)"/);
  scContent = match ? match[1] : rawSc.replace('google-site-verification=', '');
}
---

<!doctype html>
<html lang={siteConfig?.metadata?.lang || "ko"} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{/* Google Fonts — 비동기 로드 (렌더 블로킹 제거) */}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap"
			rel="stylesheet"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet" />
		</noscript>
    {/* AOS Animation CSS */}
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
			{preloadImage && (
				<link rel="preload" as="image" href={preloadImage} />
			)}
		<SEO 
			title={pageTitle} 
			description={description} 
			image={image || fallbackImage} 
			canonicalUrl={canonicalUrl} 
			type={type} 
		/>
		
		<Schema 
			type={type === 'article' ? 'Article' : 'WebSite'}
			title={pageTitle}
			description={description}
			url={canonicalUrl}
			image={image}
			authorName={authorName}
			datePublished={datePublished}
		/>
		<DynamicTheme siteConfig={siteConfig} />

		{siteConfig?.adsense_pub && (
			<script 
				is:inline
				async 
				src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.adsense_pub.startsWith('ca-pub-') ? siteConfig.adsense_pub : 'ca-pub-' + siteConfig.adsense_pub.replace('pub-', '')}`}
				crossorigin="anonymous">
			</script>
		)}

		{/* 구글 서치콘솔 소유권 인증 메타 태그 */}
		{scContent && (
			<meta name="google-site-verification" content={scContent} />
		)}

		{/* 구글 애널리틱스 (GA4) */}
		{siteConfig?.ga_measurement_id && (
			<>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.ga_measurement_id}`}></script>
				<script is:inline define:vars={{ gaId: siteConfig.ga_measurement_id }}>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', gaId);
				</script>
			</>
		)}

		{/* RSS 자동 검색(autodiscovery)용 링크 */}
		<link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS Feed`} href="/rss.xml" />
	</head>
	<body class="relative overflow-x-hidden bg-slate-50 text-slate-900 antialiased selection:bg-indigo-100 selection:text-indigo-900 flex flex-col min-h-screen">
		<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,_rgba(79,70,229,0.12),_transparent_30%),radial-gradient(circle_at_top_right,_rgba(14,165,233,0.1),_transparent_28%),linear-gradient(to_bottom,_rgba(255,255,255,0.92),_rgba(248,250,252,1))]"></div>
		{!hideHeader && <Header siteConfig={siteConfig} categories={uniqueCategories} currentLang={Astro.locals.lang || 'ko'} />}
		
		<main class="relative z-10 flex-1">
			<slot />
			<div class="mx-auto px-6 max-w-4xl">
				<NewsletterForm siteId={siteConfig?.id} domain={siteConfig?.domain || domain} />
			</div>
		</main>

		
    <!-- Dynamic Footer -->
    <footer class={`relative z-10 border-t ${theme.footerBg === 'black' ? 'bg-black text-slate-400 border-black' : theme.footerBg === 'dark' ? 'bg-slate-900 text-slate-400 border-slate-800' : theme.footerBg === 'light' ? 'bg-slate-50 text-slate-500 border-slate-200' : 'bg-white text-slate-500 border-slate-100'} ${theme.paddingY} mt-16`}>
      <div class={`mx-auto px-6 ${theme.layoutWidth} ${theme.footerCols > 1 ? 'grid gap-8' : 'flex flex-col'} ${theme.footerCols === 2 ? 'grid-cols-1 md:grid-cols-2' : theme.footerCols === 3 ? 'grid-cols-1 md:grid-cols-3' : theme.footerCols === 4 ? 'grid-cols-1 sm:grid-cols-2 md:grid-cols-4' : ''} ${theme.footerAlign === 'center' ? 'text-center items-center' : 'text-left'}`}>
        
        {/* Col 1: Brand & Company Info */}
        <div class={`flex flex-col ${theme.footerAlign === 'center' ? 'items-center' : 'items-start'}`}>
          <h3 class="text-xl font-black mb-4">{siteTitle}</h3>
          <p class="text-sm opacity-80 mb-6 max-w-xs">{siteDesc}</p>
          
          {companyInfo && (
            <div class="text-[11px] opacity-70 mb-6 space-y-1.5 leading-relaxed">
              <p className="font-semibold text-slate-400 mb-1">Company Information</p>
              <p><span className="opacity-60">상호명 :</span> {companyInfo.name}</p>
              <p><span className="opacity-60">대표자 :</span> {companyInfo.ceo}</p>
              <p><span className="opacity-60">사업자등록번호 :</span> {companyInfo.regNum}</p>
              <p><span className="opacity-60">통신판매업신고 :</span> {companyInfo.ecommerce}</p>
              <p><span className="opacity-60">이메일 :</span> {companyInfo.email}</p>
              <p><span className="opacity-60">주소 :</span> {companyInfo.address}</p>
            </div>
          )}

          <p class="text-xs opacity-60">© {new Date().getFullYear()} {siteTitle}. {t('footer.copyright')}</p>
        </div>

        {/* Col 2: Quick Links */}
        {theme.footerCols >= 2 && (
          <div class={`flex flex-col ${theme.footerAlign === 'center' ? 'items-center' : 'items-start'}`}>
            <h4 class="font-bold mb-4 uppercase text-sm tracking-wider">Quick Links</h4>
            <ul class="space-y-2 text-sm opacity-80">
              <li><a href="/about" class="hover:text-[var(--color-indigo-600)] transition-colors">About Us</a></li>
              <li><a href="/contact" class="hover:text-[var(--color-indigo-600)] transition-colors">Contact</a></li>
            </ul>
          </div>
        )}

        {/* Col 3: Legal */}
        {theme.footerCols >= 3 && (
          <div class={`flex flex-col ${theme.footerAlign === 'center' ? 'items-center' : 'items-start'}`}>
            <h4 class="font-bold mb-4 uppercase text-sm tracking-wider">Legal</h4>
            <ul class="space-y-2 text-sm opacity-80">
              <li><a href="/privacy" class="hover:text-[var(--color-indigo-600)] transition-colors">Privacy Policy</a></li>
              <li><a href="/terms" class="hover:text-[var(--color-indigo-600)] transition-colors">Terms of Service</a></li>
              <li><a href="/disclaimer" class="hover:text-[var(--color-indigo-600)] transition-colors">Disclaimer</a></li>
              <li><a href="/rss.xml" class="hover:text-[var(--color-indigo-600)] transition-colors">RSS Feed</a></li>
            </ul>
          </div>
        )}

        {/* Col 4: Categories */}
        {theme.footerCols >= 4 && (
          <div class={`flex flex-col ${theme.footerAlign === 'center' ? 'items-center' : 'items-start'}`}>
            <h4 class="font-bold mb-4 uppercase text-sm tracking-wider">Categories</h4>
            <ul class="space-y-2 text-sm opacity-80">
              {uniqueCategories.slice(0, 3).map((cat: string) => (
                <li><a href={`/category/${encodeURIComponent(cat)}`} class="hover:text-[var(--color-indigo-600)] uppercase">{cat}</a></li>
              ))}
            </ul>
          </div>
        )}

      </div>
      
      {theme.footerCols === 1 && (
        <div class="w-full border-t border-current opacity-20 mt-8 pt-8">
          <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-semibold">
            <a href="/about" class="hover:text-[var(--color-indigo-600)] transition-colors">About</a>
            <a href="/contact" class="hover:text-[var(--color-indigo-600)] transition-colors">Contact</a>
            <a href="/privacy" class="hover:text-[var(--color-indigo-600)] transition-colors">Privacy</a>
            <a href="/disclaimer" class="hover:text-[var(--color-indigo-600)] transition-colors">Disclaimer</a>
          </nav>
        </div>
      )}
    </footer>
    {/* AOS Animation JS */}
    <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script is:inline>
      document.addEventListener('astro:page-load', () => {
        if (typeof AOS !== 'undefined') {
          AOS.init({
            duration: 800,
            once: true,
            offset: 50,
            easing: 'ease-out-cubic',
          });
        }
      });
      if (document.readyState === 'complete') {
        if (typeof AOS !== 'undefined') AOS.init({ duration: 800, once: true, offset: 50 });
      } else {
        window.addEventListener('load', () => {
          if (typeof AOS !== 'undefined') AOS.init({ duration: 800, once: true, offset: 50 });
        });
      }
    </script>
  </body>
</html>
