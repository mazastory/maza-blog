---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getSiteConfig, getRequestDomain } from '../lib/api';
Astro.response.status = 404;

// 301 Redirect is dangerous here because it poisons Vercel Edge Cache.
// We rely on the meta refresh in the <head> below for fallback redirect.

const domain = getRequestDomain(Astro.request);
const siteConfig = await getSiteConfig(domain);
const lang = siteConfig?.metadata?.language || siteConfig?.metadata?.lang || Astro.locals.lang || 'ko';

const COPY: Record<string, any> = {
  ko: { title: '페이지를 찾을 수 없습니다 (404)', heading: '페이지를 찾을 수 없습니다', desc: '요청하신 페이지가 삭제되었거나, 이름이 변경되었거나, 일시적으로 사용할 수 없습니다.', redirecting: '메인 페이지로 이동 중입니다...', back: '홈으로 돌아가기' },
  en: { title: 'Page Not Found (404)', heading: 'Page Not Found', desc: 'The page you requested may have been removed, renamed, or is temporarily unavailable.', redirecting: 'Redirecting to the home page...', back: 'Back to Home' },
  ja: { title: 'ページが見つかりません (404)', heading: 'ページが見つかりません', desc: 'お探しのページは削除されたか、名前が変更されたか、一時的にご利用いただけません。', redirecting: 'ホームページに移動しています...', back: 'ホームに戻る' },
};
const c = COPY[lang] || COPY.en;
---

<Layout title={c.title}>
  <head>
    <!-- Bulletproof fallback for static hosting -->
    <meta http-equiv="refresh" content="0;url=/" />
    <script>window.location.replace("/");</script>
  </head>
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <h1 class="text-9xl font-black text-indigo-600 mb-4">404</h1>
    <h2 class="text-3xl font-bold text-slate-800 mb-4">{c.heading}</h2>
    <p class="text-slate-500 mb-8 max-w-md">
      {c.desc}<br/>
      {c.redirecting}
    </p>
    <a href="/" class="px-6 py-3 bg-indigo-600 text-white font-semibold rounded-xl shadow-md hover:bg-indigo-700 transition-colors">
      {c.back}
    </a>
  </div>
</Layout>
