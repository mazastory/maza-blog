---
export const prerender = false;
if (Astro.url.pathname === '/debug-index') {
  return new Response(JSON.stringify({ path: Astro.url.pathname }), { status: 200 });
}
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import HeroModern from '../components/hero/HeroModern.astro';
import HeroClassic from '../components/hero/HeroClassic.astro';
import HeroMagazine from '../components/hero/HeroMagazine.astro';
import HeroMinimal from '../components/hero/HeroMinimal.astro';
import HeroSplit from '../components/hero/HeroSplit.astro';
import HeroApp from '../components/hero/HeroApp.astro';
import HeroCorporate from '../components/hero/HeroCorporate.astro';
import { getApprovedPosts, getRequestDomain, getSiteConfig } from '../lib/api';
import { useTranslation } from '../lib/i18n';

import { generateThemeVars } from '../lib/theme';

// [2026-08-27] 캐시 헤더 두 줄을 제거했다. 둘 다 실제로는 아무 일도 하지 않았다.
//  · `Netlify-CDN-Cache-Control` — 이 사이트는 Vercel 에 있다(`server: Vercel`). 넷리파이 헤더는 무시된다.
//  · `Cache-Control` — ISR 라우트에서는 Vercel 이 자기 값으로 덮어쓴다.
//    (실측: 코드는 s-maxage=60 을 넣는데 운영 응답은 `public, max-age=0` 이었다)
// 이 사이트의 엣지 캐시는 astro.config.mjs 의 `adapter: vercel({ isr })` 가 정한다.

// 서버사이드(런타임)에서 접속한 도메인 기준으로 승인된 포스트만 렌더링
const url = new URL(Astro.request.url);
const domain = getRequestDomain(Astro.request);
const bypassCache = url.searchParams.has('_bust');

// [2026-08-27] DB 장애 때 "아직 작성된 글이 없습니다"를 200 으로 내보내지 않는다.
// 이 화면이 정확히 그렇게 굳어 있었다(운영 홈이 5.4일간 빈 상태로 캐시됨).
// 빈 홈은 애드센스 심사에서도 thin content 로 읽힌다 — 503 이 훨씬 안전하다.
let siteConfig, posts;
try {
  siteConfig = await getSiteConfig(domain, { bypassCache });
} catch (e) {
  console.error('[index] site config 조회 실패 — 빈 홈 대신 503:', e);
  return new Response('Service Unavailable', {
    status: 503,
    headers: { 'Retry-After': '300', 'Content-Type': 'text/plain' },
  });
}

const theme = generateThemeVars(siteConfig);
const lang = siteConfig?.metadata?.language || siteConfig?.metadata?.lang || Astro.locals.lang || 'ko';
const t = useTranslation(lang);

try {
  posts = await getApprovedPosts(domain, lang, 60, { bypassCache });
} catch (e) {
  console.error('[index] posts 조회 실패 — 빈 홈 대신 503:', e);
  return new Response('Service Unavailable', {
    status: 503,
    headers: { 'Retry-After': '300', 'Content-Type': 'text/plain' },
  });
}

let blogName = siteConfig?.blog_name || "Maza Blog";
let blogDescription = siteConfig?.metadata?.site_description || siteConfig?.niche || "Welcome to our blog.";

// [FIX] meta description이 내부 코드값(ai_tools, career 등) 그대로 노출되는 것 방지
// 최소 50자 이상의 의미있는 설명문으로 업그레이드
if (blogDescription.length < 50) {
  const niche = siteConfig?.niche || '';
  const nicheLabel = niche.replace(/_/g, ' ').trim();
  if (nicheLabel) {
    if (lang === 'en') {
      blogDescription = `${blogName} provides practical and in-depth content in the field of ${nicheLabel}. Discover expert analysis, latest trends, and practical guides.`;
    } else if (lang === 'ja') {
      blogDescription = `${blogName}は${nicheLabel}分野の実用的で詳細なコンテンツを提供します。専門家の視点で分析した最新トレンドと実践ガイドをご覧ください。`;
    } else {
      blogDescription = `${blogName}는 ${nicheLabel} 분야의 실용적이고 깊이 있는 콘텐츠를 제공합니다. 전문가의 시각으로 분석한 최신 트렌드와 실전 가이드를 확인해 보세요.`;
    }
  } else {
    if (lang === 'en') {
      blogDescription = `${blogName} shares practical, in-depth articles with expert analysis, the latest trends, and hands-on guides you can actually use.`;
    } else if (lang === 'ja') {
      blogDescription = `${blogName}は、専門家の視点による実践的で詳細な記事、最新トレンド、実用ガイドをお届けします。`;
    } else {
      blogDescription = `${blogName}는 전문가의 시각으로 분석한 실용적이고 깊이 있는 콘텐츠와 최신 트렌드, 실전 가이드를 전해드립니다.`;
    }
  }
}
let heroSubtitle = siteConfig?.metadata?.hero_subtitle || t.welcome;

if (lang === 'en' && siteConfig?.metadata?.primary_topic_en) {
  blogDescription = siteConfig.metadata.primary_topic_en.length >= 50
    ? siteConfig.metadata.primary_topic_en
    : `${blogName} — Expert insights and practical guides on ${siteConfig.metadata.primary_topic_en}. Discover in-depth analysis and the latest trends.`;
} else if (lang === 'ja' && siteConfig?.metadata?.primary_topic_ja) {
  blogDescription = siteConfig.metadata.primary_topic_ja.length >= 50
    ? siteConfig.metadata.primary_topic_ja
    : `${blogName} — ${siteConfig.metadata.primary_topic_ja}に関する専門的な情報と実践ガイドをお届けします。`;
}

if (lang === 'en' && siteConfig?.metadata?.hero_subtitle_en) {
  heroSubtitle = siteConfig.metadata.hero_subtitle_en;
} else if (lang === 'ja' && siteConfig?.metadata?.hero_subtitle_ja) {
  heroSubtitle = siteConfig.metadata.hero_subtitle_ja;
}

const featuredPost = posts.length > 0 ? posts[0] : null;
let recentPosts = posts.slice(1);

// Featured Post 대표 이미지 추출
let featuredImage = null;
if (featuredPost) {
  const metaImg = featuredPost.metadata?.data?.image1 
    || featuredPost.metadata?.blocks?.find((b: any) => b.type === 'image')?.url
    || featuredPost.metadata?.thumbnail_url
    || featuredPost.thumbnail_url
    || null;
  if (metaImg) featuredImage = metaImg;
}

const heroBgUrl = siteConfig?.metadata?.hero_bg_url || siteConfig?.metadata?.hero_image_url || null;
const heroTemplate = siteConfig?.metadata?.hero_template || theme.heroTemplate || 'modern';

// App 테마인 경우 상단 캐러셀에서 이미 최신 글 5개를 보여주므로 리스트에서 중복을 제거합니다.
if (heroTemplate === 'app') {
  recentPosts = posts.slice(5);
}

const feedClass = theme.feedStyle === 'list' 
  ? 'flex flex-col gap-8 max-w-4xl mx-auto' 
  : (theme.feedStyle === 'masonry' ? 'columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6' : 'grid gap-6 md:gap-8 sm:grid-cols-2 lg:grid-cols-3');

---

<Layout description={blogDescription} preloadImage={featuredImage} siteConfig={siteConfig} hideHeader={heroTemplate === 'corporate'}>
  {heroTemplate === 'corporate' ? (
    <HeroCorporate theme={theme} blogName={blogName} blogDescription={blogDescription} heroBgUrl={heroBgUrl} t={t} posts={posts} heroSubtitle={heroSubtitle} categories={posts.length > 0 ? Array.from(new Set(posts.map(p => p.metadata?.category).filter(Boolean))) : [siteConfig?.metadata?.primary_topic_ko || 'Trend']} />
  ) : (
    <div class="mx-auto max-w-7xl px-4 pt-8 pb-10 md:px-6 md:pt-20 md:pb-14">
      {heroTemplate === 'modern' && <HeroModern theme={theme} blogName={blogName} blogDescription={blogDescription} heroBgUrl={heroBgUrl} t={t} posts={posts} heroSubtitle={heroSubtitle} />}
    {heroTemplate === 'classic' && <HeroClassic theme={theme} blogName={blogName} blogDescription={blogDescription} heroBgUrl={heroBgUrl} t={t} posts={posts} heroSubtitle={heroSubtitle} />}
    {heroTemplate === 'magazine' && <HeroMagazine theme={theme} blogName={blogName} blogDescription={blogDescription} heroBgUrl={heroBgUrl} t={t} posts={posts} heroSubtitle={heroSubtitle} />}
    {heroTemplate === 'minimal' && <HeroMinimal theme={theme} blogName={blogName} blogDescription={blogDescription} heroBgUrl={heroBgUrl} t={t} posts={posts} heroSubtitle={heroSubtitle} />}
    {heroTemplate === 'split' && <HeroSplit theme={theme} blogName={blogName} blogDescription={blogDescription} heroBgUrl={heroBgUrl} t={t} posts={posts} heroSubtitle={heroSubtitle} />}
    {heroTemplate === 'app' && <HeroApp theme={theme} blogName={blogName} blogDescription={blogDescription} heroBgUrl={heroBgUrl} posts={posts} heroSubtitle={heroSubtitle} lang={lang} />}
    
    <!-- Hero / Featured Post -->
    {featuredPost && heroTemplate !== 'app' && (
      <section class="mb-14 md:mb-20 max-w-5xl mx-auto">
        <div class="mb-6 md:mb-8 flex items-center justify-between">
          <h2 class="text-2xl md:text-3xl font-black italic tracking-tighter text-slate-900 uppercase">{t.featured}</h2>
        </div>
        
        <a href={`/${featuredPost.slug || featuredPost.id}`} class={`group relative flex flex-col md:flex-row overflow-hidden ${theme.borderRadius} bg-white border border-slate-100 shadow-sm transition-all hover:shadow-2xl hover:shadow-indigo-100 hover:border-indigo-100`}>
          <div class="relative aspect-[16/9] w-full overflow-hidden md:aspect-[2/1] lg:aspect-[2.5/1]">
            {featuredImage ? (
              <img 
                src={featuredImage} 
                alt={featuredPost.title}
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="eager"
                decoding="sync"
              />
            ) : (
              <div class="absolute inset-0 h-full w-full bg-gradient-to-br from-indigo-100 to-purple-50 flex items-center justify-center">
                <span class="text-indigo-300 font-bold text-6xl opacity-50">{featuredPost.title.substring(0, 1)}</span>
              </div>
            )}
            <div class="absolute inset-0 bg-black/20"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
          </div>
            
          <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-10 lg:p-12">
            <div class="mb-3 md:mb-4 flex items-center gap-2">
              <span class={`rounded-full bg-indigo-500/20 px-3 py-1 text-[10px] md:text-xs font-black uppercase tracking-wider text-indigo-300 border border-indigo-500/30 backdrop-blur-md`}>
                {t.latestPick}
              </span>
            </div>
            <h3 class="mb-3 md:mb-4 text-2xl md:text-3xl font-black leading-tight text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] transition-colors break-keep line-clamp-2 md:line-clamp-none">
              {featuredPost.title}
            </h3>
            <p class="mb-6 md:mb-8 text-sm md:text-base text-slate-200 font-medium drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)] line-clamp-2 md:line-clamp-3">
              {(featuredPost.metadata?.data?.description || featuredPost.metadata?.description || featuredPost.metadata?.data?.summary || `${featuredPost.title}에 대한 상세한 정보를 확인해보세요.`)}
            </p>
            <div class="mt-auto flex items-center justify-between">
              <span class="text-sm font-bold text-white drop-shadow-md">{t.readArticle} <span class="text-indigo-400">→</span></span>
            </div>
          </div>
        </a>
      </section>
    )}

    <!-- Recent Posts Grid -->
    {recentPosts.length > 0 && (
      <section>
        <div class="mb-6 md:mb-8 flex items-center justify-between">
          <h2 class="text-xl md:text-2xl font-black italic tracking-tighter text-slate-900 uppercase">{t.recentArticles}</h2>
        </div>
        
        <div class={feedClass}>
          {recentPosts.slice(0, 6).map((post, index) => (
            <div class={`break-inside-avoid ${index >= 3 ? 'hidden sm:block' : ''}`}>
              <PostCard post={post} isPremium={theme.isPremium} lang={lang} />
            </div>
          ))}
        </div>
        
        {/* [2026-08-28] `recentPosts.length > 3`(= 전체 글 5개 이상)이면 버튼을
            보여줬는데, `/page/[page].astro` 는 전체 글이 10개를 넘어야만(대문
            피처드 1 + 1페이지 9) /page/2 에 글이 있다. 그 사이(5~10개)인
            사이트는 버튼은 뜨는데 눌러도 무조건 404 였다(vorapost.com 에서
            실제 확인). 같은 임계값(10)으로 맞춘다 — 이 값이 바뀌면 여기도
            같이 바꿔야 한다. */}
        {posts.length > 10 && (
          <div class="mt-8 md:mt-12 text-center">
            <a href="/page/2" class="inline-flex items-center justify-center rounded-full border border-slate-300 bg-white px-8 py-3 text-sm font-bold text-slate-700 shadow-sm transition-transform hover:-translate-y-0.5 hover:border-indigo-200 hover:text-indigo-700 hover:shadow-md">
              {t.loadMore}
            </a>
          </div>
        )}
      </section>
    )}



    {posts.length === 0 && (
      <div class="overflow-hidden rounded-[32px] border border-slate-200/80 bg-white/90 px-8 py-14 text-center shadow-sm md:px-12">
        <div class="mx-auto mb-6 flex h-24 w-24 items-center justify-center rounded-full bg-gradient-to-br from-slate-100 to-indigo-100 text-slate-400 shadow-inner">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </div>
        <h2 class="mb-3 text-2xl font-black tracking-tight text-slate-900">{t.emptyTitle}</h2>
        <p class="mx-auto max-w-xl text-slate-500">
          {t.emptyDesc}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/about" class="rounded-full bg-indigo-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-indigo-200 transition-transform hover:-translate-y-0.5">{t.emptyAbout}</a>
          <a href="/contact" class="rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition-transform hover:-translate-y-0.5 hover:border-indigo-200 hover:text-indigo-700">{t.emptyContact}</a>
        </div>
      </div>
    )}

  </div>
  )}
</Layout>
