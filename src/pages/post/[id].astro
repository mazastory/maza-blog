---
import { supabase } from '../../lib/supabase';

import { SAMPLE_POSTS_MOCK } from '../../lib/api';

export const prerender = false;

const { id } = Astro.params;

// Handle Dashboard Sample Posts
if (id && SAMPLE_POSTS_MOCK[id as string]) {
	const mock = SAMPLE_POSTS_MOCK[id as string];
	const slug = mock.title.toLowerCase().replace(/[^a-z0-9가-힣]+/g, '-').replace(/(^-|-$)+/g, '') + '-' + (id as string).split('-')[0];
	return Astro.redirect(`/${slug}`, 302);
}

// [2026-09-07] `/post/<슬러그>` 도 들어온다.
// 미들웨어가 `/post/(.+)` 를 통째로 가로챌 때는 슬러그든 UUID든 무조건
// `/(.+)` 로 던졌고, **슬러그인 경우엔 그게 우연히 맞는 동작**이었다.
// 가로채기를 걷어내면서 그 경로가 이리로 오므로, 여기서 두 경우를 나눈다.
//   UUID  → DB 에서 slug 를 찾아 정본으로 (아래)
//   그 외  → 옛 동작 그대로 `/<슬러그>` 로 301
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
if (id && !UUID.test(id as string)) {
	return Astro.redirect(encodeURI(`/${id}`), 301);
}

// Fetch the post's title and slug to compute the canonical path
const { data: post, error } = await supabase
	.from('posts')
	.select('slug, title')
	.eq('id', id)
	.single();

if (error || !post) {
	// [2026-09-07] `Astro.redirect('/404')` 를 쓰지 않는다.
	// 404 로 **리디렉트**하면 응답은 302 이고 목적지는 200 이라 구글이 soft 404 로
	// 본다. 404.astro 에도 "404 는 404 로 둔다"고 적혀 있는데 여기만 어긋나 있었다.
	// 없는 글은 그 자리에서 404 상태로 답한다.
	return new Response(null, { status: 404 });
}

// If slug exists in DB, use it. Otherwise derive it from title + id prefix (same as api.ts computeSlug)
let targetSlug = post.slug;
if (!targetSlug && post.title) {
	targetSlug = post.title
		.toLowerCase()
		.replace(/[^a-z0-9가-힣]+/g, '-')
		.replace(/(^-|-$)+/g, '')
		+ '-' + (id as string).split('-')[0];
}

const targetPath = targetSlug ? `/${targetSlug}` : `/${id}`;
return Astro.redirect(encodeURI(targetPath), 301);
---
