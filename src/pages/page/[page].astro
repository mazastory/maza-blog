---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getApprovedPosts, getRequestDomain, getSiteConfig } from '../../lib/api';

// [2026-08-27] 캐시 헤더 두 줄을 제거했다. 둘 다 실제로는 아무 일도 하지 않았다.
//  · `Netlify-CDN-Cache-Control` — 이 사이트는 Vercel 에 있다(`server: Vercel`). 넷리파이 헤더는 무시된다.
//  · `Cache-Control` — ISR 라우트에서는 Vercel 이 자기 값으로 덮어쓴다.
//    (실측: 코드는 s-maxage=60 을 넣는데 운영 응답은 `public, max-age=0` 이었다)
// 이 사이트의 엣지 캐시는 astro.config.mjs 의 `adapter: vercel({ isr })` 가 정한다.

const domain = getRequestDomain(Astro.request);
const pageParam = Astro.params.page;
const page = parseInt(pageParam || '1', 10);

if (isNaN(page) || page < 1) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
  return Astro.rewrite('/404');
}

const siteConfig = await getSiteConfig(domain);
const lang = siteConfig?.metadata?.language || siteConfig?.metadata?.lang || Astro.locals.lang || 'ko';
const allPosts = await getApprovedPosts(domain, lang);
// index.astro에서 featuredPost 1개 + 첫 9개를 보여줬음 (총 10개)
// 따라서 /page/2 에서는 11번째 포스트부터 보여주면 됨
const postsPerPage = 9;
const offset = 1 + (page - 1) * postsPerPage;

const pagePosts = allPosts.slice(offset, offset + postsPerPage);
const hasNextPage = allPosts.length > offset + postsPerPage;

if (pagePosts.length === 0 && page > 1) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
  return Astro.rewrite('/404');
}

const PAGE_LABELS: Record<string, { title: string; desc: string; backHome: string; prevPage: string; firstPage: string; nextPage: string; lastPage: string }> = {
  ko: { title: '전체 글', desc: '전체 포스트 목록', backHome: '홈으로 돌아가기', prevPage: '이전 페이지', firstPage: '첫 페이지', nextPage: '다음 페이지', lastPage: '마지막 페이지' },
  en: { title: 'All Posts', desc: 'Full list of posts', backHome: 'Back to Home', prevPage: 'Previous Page', firstPage: 'First Page', nextPage: 'Next Page', lastPage: 'Last Page' },
  ja: { title: 'すべての記事', desc: '記事一覧', backHome: 'ホームに戻る', prevPage: '前のページ', firstPage: '最初のページ', nextPage: '次のページ', lastPage: '最後のページ' },
};
const pl = PAGE_LABELS[lang] || PAGE_LABELS.en;
---

<Layout title={`${pl.title} - ${page}`} description={`${pl.desc} (${page})`}>
  <div class="mx-auto max-w-5xl px-6 pt-12 pb-20 md:pt-20">

    <header class="mb-14 text-center">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-slate-100 px-4 py-1.5 text-sm font-bold text-slate-500 border border-slate-200">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        <a href="/" class="hover:text-indigo-600 transition-colors">{pl.backHome}</a>
      </div>
      <h1 class="text-4xl font-black tracking-tight text-slate-900 md:text-5xl">
        {pl.title} <span class="text-indigo-600 font-medium text-2xl ml-2">Page {page}</span>
      </h1>
    </header>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {pagePosts.map(post => (
        <PostCard post={post} lang={lang} />
      ))}
    </div>

    <div class="mt-16 flex items-center justify-between border-t border-slate-200 pt-8">
      {page > 2 ? (
        <a href={`/page/${page - 1}`} class="inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          {pl.prevPage}
        </a>
      ) : (
        <a href="/" class="inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          {pl.firstPage}
        </a>
      )}

      {hasNextPage ? (
        <a href={`/page/${page + 1}`} class="inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-colors">
          {pl.nextPage}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      ) : (
        <div class="px-4 py-2 text-sm font-medium text-slate-400">{pl.lastPage}</div>
      )}
    </div>
  </div>
</Layout>
