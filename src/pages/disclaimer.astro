---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getSiteConfig, getRequestDomain } from '../lib/api';

const domain = getRequestDomain(Astro.request);
const siteConfig = await getSiteConfig(domain);
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=86400, stale-if-error=86400');
const blogName = siteConfig?.blog_name || "Maza Blog";
const niche = siteConfig?.niche || '';
const currentYear = new Date().getFullYear();
const lang = siteConfig?.metadata?.language || siteConfig?.metadata?.lang || Astro.locals.lang || 'ko';

const COPY: Record<string, any> = {
  ko: {
    title: '면책 조항 (Disclaimer)',
    metaDesc: `${blogName} 면책 조항 — 본 사이트의 콘텐츠 정책, AI 활용 고지, 광고 수익 고지를 확인하세요.`,
    badge: 'Legal',
    intro: (d: string, y: number) => `<strong>${d}</strong>을 이용하시기 전에 아래 면책 조항을 꼭 읽어보시기 바랍니다. 최종 업데이트: ${y}년`,
    generalTitle: '일반 정보 제공 목적',
    generalDesc: (name: string, d: string, n: string) => `${name}(${d})에서 제공하는 모든 정보와 콘텐츠는${n ? ` ${n} 분야를 포함한` : ''} 일반적인 정보 제공만을 목적으로 하며, 어떠한 형태의 법적·재무적·의학적 또는 기타 전문적인 조언을 대체할 수 없습니다. 본 사이트의 정보를 바탕으로 내린 결정에 대한 모든 책임은 사용자 본인에게 있습니다.`,
    aiTitle: 'AI 생성 콘텐츠 고지 (AI Content Disclosure)',
    aiDesc: (name: string) => `${name}의 일부 콘텐츠는 AI(인공지능) 도구를 활용하여 초안이 작성될 수 있습니다. AI를 통해 생성된 콘텐츠는 발행 전 편집자의 검토 및 사실 확인 과정을 거치지만, AI의 특성상 부정확한 정보나 오류가 포함될 가능성을 완전히 배제할 수 없습니다. 본 사이트의 콘텐츠는 참고용으로만 활용하시고, 중요한 결정을 내리기 전에 전문가와 반드시 상담하시기 바랍니다.`,
    monetTitle: '광고 및 제휴 수익 고지 (Advertising & Affiliate Disclosure)',
    monetIntro: (name: string) => `${name}은 지속적인 운영을 위해 다음과 같은 수익 창출 방식을 활용하고 있습니다. 이 사실을 독자에게 투명하게 공개합니다.`,
    monetLi1: 'Google AdSense: 본 사이트에는 Google AdSense를 통한 광고가 게재될 수 있습니다. Google은 쿠키를 사용하여 사용자의 관심사에 맞는 광고를 표시할 수 있습니다.',
    monetLi2: '제휴 마케팅: 쿠팡 파트너스 등 제휴 프로그램에 참여하고 있으며, 제휴 링크를 통한 구매 시 소정의 수수료가 발생할 수 있습니다. 이는 구매 가격에 영향을 미치지 않습니다.',
    monetLi3: '스폰서 콘텐츠: 스폰서십이 포함된 콘텐츠는 명시적으로 표시됩니다.',
    monetOutro: '광고 수익은 본 사이트의 운영 및 양질의 콘텐츠 제작을 위해 사용됩니다.',
    linksTitle: '외부 링크 (External Links)',
    linksDesc: (name: string) => `본 사이트의 콘텐츠에는 외부 웹사이트로 연결되는 링크가 포함될 수 있습니다. 이러한 외부 사이트의 콘텐츠, 개인정보 보호 정책 또는 관행에 대해 ${name}은 책임을 지지 않습니다. 외부 링크를 클릭하기 전에 해당 사이트의 이용약관 및 개인정보 보호 정책을 확인하시기 바랍니다.`,
    accuracyTitle: '정보의 정확성 및 최신성',
    accuracyDesc: (name: string, n: string) => `${name}은${n ? ` ${n} 분야를 포함한` : ''} 각 주제에 대해 정확하고 최신의 정보를 제공하기 위해 노력합니다. 그러나 정보의 변경 속도가 빠른 분야의 특성상, 일부 내용이 최신 상황을 반영하지 못할 수 있습니다. 중요한 사안에 대해서는 반드시 공식 기관 또는 전문가를 통해 최신 정보를 확인하시기 바랍니다.`,
    footerPre: (y: number) => `본 면책 조항은 ${y}년 기준으로 작성되었으며 사전 공지 없이 변경될 수 있습니다. 문의 사항은 `,
    footerLink: 'Contact 페이지',
    footerPost: '를 이용해 주세요.',
    operatedBy: '운영 사이트', blogNameLabel: '블로그명',
  },
  en: {
    title: 'Disclaimer',
    metaDesc: `Disclaimer for ${blogName} — our content policy, AI usage disclosure, and advertising revenue disclosure.`,
    badge: 'Legal',
    intro: (d: string, y: number) => `Please read the disclaimer below before using <strong>${d}</strong>. Last updated: ${y}`,
    generalTitle: 'General Informational Purpose',
    generalDesc: (name: string, d: string, n: string) => `All information and content provided by ${name} (${d})${n ? `, including topics related to ${n},` : ''} is for general informational purposes only and does not substitute for legal, financial, medical, or other professional advice. You are solely responsible for any decisions made based on information from this site.`,
    aiTitle: 'AI Content Disclosure',
    aiDesc: (name: string) => `Some content on ${name} may be drafted with the help of AI (artificial intelligence) tools. AI-assisted content goes through editorial review and fact-checking before publication, but the possibility of inaccuracies or errors inherent to AI cannot be completely ruled out. Please treat content on this site as a reference only, and consult a qualified professional before making important decisions.`,
    monetTitle: 'Advertising & Affiliate Disclosure',
    monetIntro: (name: string) => `${name} uses the following revenue methods to keep the site running. We disclose this transparently to our readers.`,
    monetLi1: 'Google AdSense: Ads may be served on this site through Google AdSense. Google uses cookies to serve ads relevant to a user\'s interests.',
    monetLi2: 'Affiliate marketing: We participate in affiliate programs such as Coupang Partners. Purchases made through affiliate links may earn us a commission, at no extra cost to you.',
    monetLi3: 'Sponsored content: Any sponsored content is clearly labeled as such.',
    monetOutro: 'Advertising revenue is used to operate this site and produce quality content.',
    linksTitle: 'External Links',
    linksDesc: (name: string) => `This site's content may include links to external websites. ${name} is not responsible for the content, privacy policies, or practices of those external sites. Please review the terms and privacy policy of any external site before clicking through.`,
    accuracyTitle: 'Accuracy & Timeliness of Information',
    accuracyDesc: (name: string, n: string) => `${name} strives to provide accurate and up-to-date information on every topic${n ? `, including ${n},` : ''}. However, given how quickly information can change in fast-moving fields, some content may not reflect the latest developments. For important matters, please verify the latest information through official sources or a qualified professional.`,
    footerPre: (y: number) => `This disclaimer was last written in ${y} and may change without prior notice. For questions, please use our `,
    footerLink: 'Contact page',
    footerPost: '.',
    operatedBy: 'Operated by', blogNameLabel: 'Blog name',
  },
  ja: {
    title: '免責事項 (Disclaimer)',
    metaDesc: `${blogName}の免責事項 — 本サイトのコンテンツポリシー、AI利用の告知、広告収益の告知をご確認ください。`,
    badge: 'Legal',
    intro: (d: string, y: number) => `<strong>${d}</strong>をご利用になる前に、以下の免責事項を必ずお読みください。最終更新日: ${y}年`,
    generalTitle: '一般的な情報提供目的',
    generalDesc: (name: string, d: string, n: string) => `${name}(${d})が提供するすべての情報およびコンテンツは${n ? `${n}分野を含め、` : ''}一般的な情報提供のみを目的としており、法律・financial・医療その他専門的な助言に代わるものではありません。本サイトの情報に基づいて下した判断についての責任は、すべて利用者ご自身に帰属します。`,
    aiTitle: 'AI生成コンテンツの告知 (AI Content Disclosure)',
    aiDesc: (name: string) => `${name}の一部のコンテンツは、AI(人工知能)ツールを活用して下書きが作成される場合があります。AIによって生成されたコンテンツは公開前に編集者による確認・ファクトチェックを経ますが、AIの特性上、不正確な情報や誤りが含まれる可能性を完全には排除できません。本サイトのコンテンツは参考情報としてのみご利用いただき、重要な判断の前には必ず専門家にご相談ください。`,
    monetTitle: '広告・アフィリエイト収益の告知 (Advertising & Affiliate Disclosure)',
    monetIntro: (name: string) => `${name}は継続的な運営のため、以下のような収益化手法を活用しています。この事実を読者の皆様に透明性を持って公開します。`,
    monetLi1: 'Google AdSense: 本サイトにはGoogle AdSenseによる広告が掲載される場合があります。Googleはクッキーを使用して、ユーザーの興味に合わせた広告を表示することがあります。',
    monetLi2: 'アフィリエイトマーケティング: Coupangパートナーズなどのアフィリエイトプログラムに参加しており、アフィリエイトリンク経由の購入により所定の手数料が発生する場合があります。これは購入価格に影響しません。',
    monetLi3: 'スポンサーコンテンツ: スポンサーシップを含むコンテンツには、その旨が明示されます。',
    monetOutro: '広告収益は、本サイトの運営および質の高いコンテンツ制作のために使用されます。',
    linksTitle: '外部リンク (External Links)',
    linksDesc: (name: string) => `本サイトのコンテンツには、外部ウェブサイトへのリンクが含まれる場合があります。これら外部サイトのコンテンツ、プライバシーポリシーまたは慣行について、${name}は責任を負いません。外部リンクをクリックする前に、該当サイトの利用規約およびプライバシーポリシーをご確認ください。`,
    accuracyTitle: '情報の正確性および最新性',
    accuracyDesc: (name: string, n: string) => `${name}は${n ? `${n}分野を含め、` : ''}各トピックについて正確かつ最新の情報を提供するよう努めています。しかし、変化の速い分野の特性上、一部の内容が最新の状況を反映していない場合があります。重要な事項については、必ず公式機関または専門家を通じて最新情報をご確認ください。`,
    footerPre: (y: number) => `本免責事項は${y}年時点で作成されており、事前の告知なく変更される場合があります。お問い合わせは`,
    footerLink: 'お問い合わせページ',
    footerPost: 'をご利用ください。',
    operatedBy: '運営サイト', blogNameLabel: 'ブログ名',
  },
};
const c = COPY[lang] || COPY.en;
---
<Layout title={c.title} description={c.metaDesc} siteConfig={siteConfig}>
  <main class="mx-auto max-w-4xl px-6 py-20 md:py-24 relative">
    <div class="absolute top-0 right-0 w-full h-96 bg-gradient-to-b from-slate-100 to-transparent -z-10"></div>

    <div class="mb-12 border-b border-slate-200 pb-12">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-orange-50 px-4 py-2 text-sm font-bold uppercase tracking-widest text-orange-600 border border-orange-100">
        {c.badge}
      </div>
      <h1 class="text-4xl font-black leading-tight tracking-tight text-slate-900 md:text-5xl">
        {c.title}
      </h1>
      <p class="mt-4 text-slate-500 font-medium" set:html={c.intro(domain, currentYear)} />
    </div>

    <div class="prose prose-lg prose-slate max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-indigo-600 hover:prose-a:text-indigo-700">

      <!-- 1. 일반 정보 제공 목적 -->
      <div class="rounded-3xl border border-orange-200 bg-orange-50/50 p-8 mb-10">
        <h2 class="text-xl font-bold text-orange-900 m-0 mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-500"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
          {c.generalTitle}
        </h2>
        <p class="text-orange-800 m-0 leading-relaxed">
          {c.generalDesc(blogName, domain, niche)}
        </p>
      </div>

      <!-- 2. AI 활용 고지 -->
      <div class="rounded-3xl border border-blue-200 bg-blue-50/50 p-8 mb-10">
        <h2 class="text-xl font-bold text-blue-900 m-0 mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
          {c.aiTitle}
        </h2>
        <p class="text-blue-800 m-0 leading-relaxed">
          {c.aiDesc(blogName)}
        </p>
      </div>

      <!-- 3. 수익 창출 고지 -->
      <h3>{c.monetTitle}</h3>
      <p>
        {c.monetIntro(blogName)}
      </p>
      <ul>
        <li>{c.monetLi1}</li>
        <li>{c.monetLi2}</li>
        <li>{c.monetLi3}</li>
      </ul>
      <p>
        {c.monetOutro}
      </p>

      <!-- 4. 외부 링크 -->
      <h3>{c.linksTitle}</h3>
      <p>
        {c.linksDesc(blogName)}
      </p>

      <!-- 5. 정보의 정확성 -->
      <h3>{c.accuracyTitle}</h3>
      <p>
        {c.accuracyDesc(blogName, niche)}
      </p>

      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 mt-10 text-sm text-slate-600">
        <p class="m-0">
          {c.footerPre(currentYear)}<a href="/contact">{c.footerLink}</a>{c.footerPost}
          <br/>{c.operatedBy}: <strong>{domain}</strong> · {c.blogNameLabel}: <strong>{blogName}</strong>
        </p>
      </div>
    </div>
  </main>
</Layout>
