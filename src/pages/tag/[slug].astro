---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getApprovedPosts, getRequestDomain, getSiteConfig } from '../../lib/api';

// [2026-08-27] 캐시 헤더 두 줄을 제거했다. 둘 다 실제로는 아무 일도 하지 않았다.
//  · `Netlify-CDN-Cache-Control` — 이 사이트는 Vercel 에 있다(`server: Vercel`). 넷리파이 헤더는 무시된다.
//  · `Cache-Control` — ISR 라우트에서는 Vercel 이 자기 값으로 덮어쓴다.
//    (실측: 코드는 s-maxage=60 을 넣는데 운영 응답은 `public, max-age=0` 이었다)
// 이 사이트의 엣지 캐시는 astro.config.mjs 의 `adapter: vercel({ isr })` 가 정한다.

const domain = getRequestDomain(Astro.request);
const { slug } = Astro.params;

if (!slug) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
  return Astro.rewrite('/404');
}

const siteConfig = await getSiteConfig(domain);
const lang = siteConfig?.metadata?.language || siteConfig?.metadata?.lang || Astro.locals.lang || 'ko';
const allPosts = await getApprovedPosts(domain, lang);
// 태그 필터링: 대소문자 무시, '#' 제거 후 매칭
const tagPosts = allPosts.filter(post => {
  const tags = post.metadata?.hashtags || [];
  return tags.some((t: string) => t.replace(/^#/, '').toLowerCase() === slug.toLowerCase());
});
import { resolveLang, useTranslations } from '../../i18n/utils';
const t = useTranslations(resolveLang(lang));
---

<Layout title={`${t('search.tag.title')}: #${slug}`} description={t('search.tag.desc')}>
  <div class="mx-auto max-w-5xl px-6 pt-12 pb-20 md:pt-20">
    
    <header class="mb-14 text-center">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-slate-100 px-4 py-1.5 text-sm font-bold text-slate-500 border border-slate-200">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        <a href="/" class="hover:text-indigo-600 transition-colors">{t('search.back')}</a>
      </div>
      <h1 class="text-4xl font-black tracking-tight text-slate-900 md:text-5xl">
        <span class="text-indigo-600">#</span>{slug}
      </h1>
      <p class="mt-4 text-lg text-slate-500">
        {t('search.tag.count').replace('{count}', tagPosts.length.toString())}
      </p>
    </header>

    {tagPosts.length > 0 ? (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {tagPosts.map(post => (
          <PostCard post={post} lang={lang} />
        ))}
      </div>
    ) : (
      <div class="py-20 text-center">
        <p class="text-slate-500">{t('search.tag.empty')}</p>
      </div>
    )}
  </div>
</Layout>
