---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getApprovedPosts, getRequestDomain, getSiteConfig } from '../../lib/api';

// 캐시 설정으로 로딩 속도 대폭 개선 (SWR 적용)
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=86400, stale-if-error=86400');
Astro.response.headers.set('Netlify-CDN-Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=86400, stale-if-error=86400');

const domain = getRequestDomain(Astro.request);
const { slug } = Astro.params;

if (!slug) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
  return Astro.rewrite('/404');
}

const decodedSlug = decodeURIComponent(slug);
const siteConfig = await getSiteConfig(domain);
const lang = siteConfig?.metadata?.language || siteConfig?.metadata?.lang || Astro.locals.lang || 'ko';
const allPosts = await getApprovedPosts(domain, lang);

// 카테고리 필터링: 대소문자 무시 매칭
let categoryPosts = allPosts.filter(post => {
  const category = post.metadata?.category || '';
  return category.toLowerCase() === decodedSlug.toLowerCase();
});

import { generateThemeVars } from '../../lib/theme';
import { getCategoryLabel, getCategoryDescription } from '../../lib/categories';
const theme = generateThemeVars(siteConfig);

// 만약 해당 카테고리의 포스트가 없고, 현재 요청한 카테고리가 사이트 기본 카테고리와 일치한다면
// 카테고리가 지정되지 않은(undefined/빈 문자열) 포스트들을 기본 카테고리로 간주하여 보여줍니다.
if (categoryPosts.length === 0) {
  const fallbackCategory = siteConfig?.metadata?.primary_topic_ko || 'Trend';
  
  if (decodedSlug.toLowerCase() === fallbackCategory.toLowerCase()) {
    categoryPosts = allPosts.filter(post => !post.metadata?.category);
  }
}

// 카테고리별 동적 설명 (SEO용 Thin Content 방어)
// [LABEL] 옛 설명 맵은 it/health/finance/travel/life 5종만 갖고 있어서
// 현재 운영 중인 카테고리는 단 하나도 대응되지 않았고, 전부
// "'knowledge_biz'와 관련된 깊이 있고 실용적인 정보" 같은 기계 문구로 나갔다.
// 라벨/설명을 lib/categories.ts로 일원화한다.
const currentDesc = getCategoryDescription(decodedSlug, lang);
const categoryLabel = getCategoryLabel(decodedSlug, lang);

const CATEGORY_PAGE_LABELS: Record<string, { badge: string; count: (n: number) => string; empty: string }> = {
  ko: { badge: '카테고리 모음', count: (n) => `총 ${n}개의 전문 포스트가 등록되어 있습니다.`, empty: '해당 카테고리에 작성된 글이 없습니다.' },
  en: { badge: 'Category Collection', count: (n) => `${n} articles in this category.`, empty: 'No articles have been published in this category yet.' },
  ja: { badge: 'カテゴリー一覧', count: (n) => `このカテゴリーには${n}件の記事があります。`, empty: 'このカテゴリーの記事はまだありません。' },
};
const pageLabels = CATEGORY_PAGE_LABELS[lang] || CATEGORY_PAGE_LABELS.en;
---

<Layout title={`${categoryLabel} | ${siteConfig?.blog_name || 'Blog'}`} description={currentDesc}>
  <div class="mx-auto max-w-5xl px-6 pt-12 pb-20 md:pt-20">

    <header class="mb-14 text-center">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-indigo-50 px-4 py-1.5 text-sm font-bold text-indigo-600 border border-indigo-100">
        {pageLabels.badge}
      </div>
      <h1 class="text-4xl font-black tracking-tight text-slate-900 md:text-5xl capitalize">
        {categoryLabel}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600 leading-relaxed font-medium">
        {currentDesc}
      </p>
      <p class="mt-4 text-sm text-slate-400">
        {pageLabels.count(categoryPosts.length)}
      </p>
    </header>

    {categoryPosts.length > 0 ? (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {categoryPosts.map(post => (
          <PostCard post={post} isPremium={theme.isPremium} lang={lang} />
        ))}
      </div>
    ) : (
      <div class="py-20 text-center">
        <p class="text-slate-500">{pageLabels.empty}</p>
      </div>
    )}
  </div>
</Layout>
