---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getSiteConfig, getRequestDomain } from '../lib/api';

const domain = getRequestDomain(Astro.request);
const siteConfig = await getSiteConfig(domain);
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=86400, stale-if-error=86400');
const blogName = siteConfig?.blog_name || "Maza Blog";
const niche = siteConfig?.niche || '';
const contactEmail = siteConfig?.metadata?.contact_email || `contact@${domain || 'example.com'}`;

const lang = siteConfig?.metadata?.language || siteConfig?.metadata?.lang || Astro.locals.lang || 'ko';

// niche 기반 문의 안내 문구
const contactDesc = lang === 'en'
  ? (niche
    ? `Do you have questions, partnership proposals, or content inquiries related to ${niche}? The ${blogName} team will get back to you quickly.`
    : `Do you have any questions or partnership proposals? The ${blogName} team always welcomes your messages.`)
  : (niche
    ? `${niche} 관련 제보, 협업 제안, 또는 콘텐츠 관련 문의가 있으신가요? ${blogName} 팀이 빠르게 답변드리겠습니다.`
    : `문의 사항이나 협업 제안이 있으신가요? ${blogName} 팀은 언제나 여러분의 연락을 환영합니다.`);
---
<Layout title={lang === 'en' ? `Contact Us` : `문의하기`} description={lang === 'en' ? `Contact ${blogName}. We welcome inquiries and partnerships.` : `${blogName}(${domain}) 문의 페이지. ${niche ? niche + ' 관련 ' : ''}제보, 협업, 광고 문의를 환영합니다.`} siteConfig={siteConfig}>
  <main class="mx-auto max-w-4xl px-6 py-20 md:py-32 relative">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-fuchsia-200/30 rounded-full blur-[100px] -z-10"></div>
    <div class="absolute top-64 -left-24 w-96 h-96 bg-indigo-200/30 rounded-full blur-[100px] -z-10"></div>

    <div class="overflow-hidden rounded-[40px] border border-slate-200/80 bg-white/60 backdrop-blur-2xl p-10 md:p-16 shadow-[0_32px_80px_-48px_rgba(79,70,229,0.3)]">
      <div class="mb-8 inline-flex items-center gap-2 rounded-full bg-indigo-50 px-4 py-2 text-sm font-bold uppercase tracking-widest text-indigo-600 border border-indigo-100">
        Contact Us
      </div>
      
      <h1 class="mb-6 text-4xl font-black leading-tight tracking-tight text-slate-900 md:text-5xl">
        {lang === 'en' ? 'Get in Touch with' : '무엇이든'}<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-sky-500">{lang === 'en' ? blogName : '물어보세요'}</span>
      </h1>

      {niche && (
        <p class="mb-4 text-sm font-semibold text-indigo-500">
          {niche} 전문 블로그 · {domain}
        </p>
      )}
      
      <p class="mb-12 text-lg text-slate-500 max-w-2xl mx-auto">
        {contactDesc}
      </p>
      
      <div class="inline-block p-1 rounded-3xl bg-gradient-to-br from-indigo-500 to-fuchsia-500 shadow-xl">
        <div class="flex items-center gap-4 rounded-[22px] bg-white px-8 py-6 md:px-12 md:py-8">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <div class="text-left">
            <p class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-1">Email Address</p>
            <a href={`mailto:${contactEmail}`} class="text-xl md:text-2xl font-black text-slate-900 hover:text-indigo-600 transition-colors">
              {contactEmail}
            </a>
          </div>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-3 text-sm text-slate-500">
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          평균 1~2일 내 답변
        </span>
        <span class="text-slate-300">·</span>
        <span>광고 문의, 콘텐츠 제보, 협업 모두 환영합니다</span>
      </div>
    </div>
  </main>
</Layout>
